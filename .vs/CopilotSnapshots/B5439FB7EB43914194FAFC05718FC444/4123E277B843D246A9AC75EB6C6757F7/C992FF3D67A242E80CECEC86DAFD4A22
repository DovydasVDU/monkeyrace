@using Microsoft.AspNetCore.Http
@{
    var username = ViewContext.HttpContext.Session.GetString("Username");
}

<!DOCTYPE html>
<html>
<head>
<title>MonkeyRacer</title>
<script src="/js/login.js"></script>
<link rel="stylesheet" href="/css/login.css">
<style>

:root{
--bg:#1a1a2e;
--surface:#16213e;
--accent:#e2b714;
--text:#ffffff;
--muted:#646669;
}

*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
background:var(--bg);
color:var(--text);
font-family:'Courier New', monospace;
min-height:100vh;
}




/* ---------------- HOME ---------------- */

.home-container{
display:flex;
justify-content:center;
align-items:center;
height:80vh;
gap:4rem;
}

/* GAME CARDS */

.card{
background:var(--surface);
border:1px solid #333;
border-radius:12px;
width:320px;
padding:2.5rem;
text-align:center;
transition:transform .2s, box-shadow .2s;
cursor:pointer;
}

.card:hover{
transform:translateY(-6px);
box-shadow:0 8px 25px rgba(0,0,0,0.4);
}

.card h2{
color:var(--accent);
font-size:1.1rem;
letter-spacing:.15em;
margin-bottom:2rem;
}

.card p{
color:var(--muted);
font-size:.85rem;
margin-bottom:1.5rem;
}

.card-input {
width:100%;
margin-bottom:.8rem;
padding:.6rem;
background:#111;
border:1px solid #333;
color:white;
border-radius:4px;
font-family:inherit;
text-align:center;
}

.btn{
width:100%;
margin-top:.6rem;
padding:.7rem;
border-radius:5px;
border:1px solid var(--accent);
background:transparent;
color:var(--accent);
cursor:pointer;
font-size:.9rem;
transition:all .2s;
}

.btn:hover{
background:var(--accent);
color:var(--bg);
}


</style>
</head>

<body>

<!-- NAVBAR -->

<header class="navbar">

<div class="logo">MonkeyRacer</div>

<div class="nav-right">

@if(username != null)
{
<div class="user-menu" onclick="toggleMenu()">

<div class="user-icon">
@username.Substring(0,1).ToUpper()
</div>

<div class="username">@username</div>

<div class="dropdown" id="userDropdown">

<a href="/User/Stats">User Stats</a>
<a href="/User/Settings">Account Settings</a>
<a href="/Auth/Logout">Log Out</a>

</div>

</div>
}
else
{
<button class="nav-btn" onclick="openLogin()">Login</button>
}

</div>

</header>


<!-- MAIN -->

<div class="home-container">

<!-- SOLO TEST -->

<div class="card" onclick="startSolo()">

<h2>SOLO TEST</h2>

<p>Practice your typing speed and accuracy.</p>

<button class="btn">Start Race</button>

</div>


<!-- ONLINE RACE -->

<div class="card">

<h2>ONLINE RACE</h2>

@if(username != null)
{
<p style="margin-bottom:.8rem;">Playing as <span style="color:var(--accent)">@username</span></p>
<input type="hidden" id="username-input" value="@username" />
}
else
{
<input id="username-input" class="card-input" placeholder="Your name (optional)" maxlength="20" />
}

<button class="btn" onclick="createRoom()">Create Room</button>

<div style="color:var(--muted); margin:.8rem 0; font-size:.85rem;">— OR —</div>

<input id="room-id-input" class="card-input" placeholder="Enter Room ID" />
<button class="btn" onclick="joinRoom()">Join Room</button>

</div>

</div>


<!-- LOGIN MODAL -->

<div class="modal" id="loginModal">

<div class="modal-box" style="position: relative;">

<span onclick="closeLogin()" style="position: absolute; top: 1rem; right: 1rem; cursor: pointer; color: var(--muted); font-size: 1.2rem;">&times;</span>

<h3>login</h3>

<input id="login-user" placeholder="username">
<input id="login-pass" type="password" placeholder="password">

<button class="btn" onclick="login()">login</button>
<button class="btn" onclick="register()">register</button>

</div>

</div>



    <script src="/js/login.js"></script>
    <script>



            function toggleMenu(){
            document.getElementById("userDropdown").classList.toggle("visible");
            }

            function startSolo(){
            window.location="/Race/Play";
        }

        /* ROOM LOGIC */

        function createRoom() {
            const roomId = Math.random().toString(36).substring(2, 8).toUpperCase();
            redirectToRoom(roomId);
        }

        function joinRoom() {
            const roomId = document.getElementById('room-id-input').value.trim();
            if (!roomId) return alert('Enter room id');
            redirectToRoom(roomId);
        }

        function redirectToRoom(roomId) {
            const usernameInput = document.getElementById('username-input');
            const username = (usernameInput ? usernameInput.value.trim() : "") || 'Svečias';

            sessionStorage.setItem('username', username);
            window.location.href = `/Race/MultiPlay?roomId=${roomId}`;
        }

       


    </script>



</body>
</html>
