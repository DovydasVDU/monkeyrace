<!DOCTYPE html>
<html>
<head>
    <title>MonkeyRacer – @ViewBag.RoomId</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <style>
        :root { --bg:#1a1a2e; --surface:#16213e; --accent:#e2b714; --text:#d1d0c5; --muted:#646669; --correct:#fff; --error:#ca4754; }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { background:var(--bg); color:var(--text); font-family:'Courier New', monospace; display:flex; align-items:center; justify-content:center; min-height:100vh; }
        .race-container { max-width:800px; width:100%; padding:2rem; margin:auto; }

        .players-bar { margin-bottom: 1.5rem; }
        .player-row { display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem; }
        .player-name { width: 150px; font-size: 0.85rem; color: var(--muted); }
        .progress-track { flex: 1; height: 8px; background: #333; border-radius: 4px; overflow: hidden; display: none; }
        .progress-fill { height: 100%; background: var(--accent); border-radius: 4px; transition: width 0.3s ease; width: 0%; }
        .player-status { width: 80px; font-size: 0.8rem; text-align: right; }
        .player-status.ready { color: var(--correct); }
        .player-status.not-ready { color: var(--error); }

        .live-stats { display: flex; align-items: center; gap: 0.5rem; width: 140px; justify-content: flex-end; }
        .live-wpm { font-size: 0.8rem; color: var(--accent); font-weight: bold; }
        .live-word { font-size: 0.8rem; color: var(--text); background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 80px; text-align: left; }
        .place-1 { color: #ffd700 !important; font-weight: bold; text-shadow: 0 0 5px rgba(255,215,0,0.5); }
        .place-2 { color: #c0c0c0 !important; font-weight: bold; text-shadow: 0 0 5px rgba(192,192,192,0.5); }
        .place-3 { color: #cd7f32 !important; font-weight: bold; text-shadow: 0 0 5px rgba(205,127,50,0.5); }

        .player-row.me .player-name { color: var(--accent); }
        .player-row.finished .progress-fill { background: var(--correct); }

        .btn { padding:0.8rem 1.5rem; background:transparent; border:1px solid var(--accent); color:var(--accent); font-family:inherit; border-radius:4px; cursor:pointer; margin-right: 0.5rem; }
        .btn:hover { background:var(--accent); color:var(--bg); }
        .btn:disabled { border-color: var(--muted); color: var(--muted); cursor: not-allowed; background: transparent; }

        .stats-bar { display: none; gap: 2rem; margin-bottom: 1rem; color: var(--muted); }
        .stat { font-size: 1.2rem; }
        .stat span { font-weight: bold; color: var(--accent); font-size: 1.5rem; }

        .text-display { display: none; font-size: 1.5rem; line-height: 1.5; color: var(--muted); margin-bottom: 2rem; position: relative; }
        .char { transition: color 0.1s; }
        .char.correct { color: var(--correct); }
        .char.error { color: var(--error); background: rgba(202,71,84,0.2); }
        .char.current { color: var(--text); border-bottom: 2px solid var(--accent); }
        .char.space.error { border-bottom: 2px solid var(--error); }

        .word-input { display: none; width: 100%; max-width: 400px; margin: 0 auto; padding: 1rem; font-size: 1.5rem; background: var(--surface); color: var(--text); border: 2px solid #333; border-radius: 8px; text-align: center; font-family: 'Courier New', monospace; outline: none; transition: border-color 0.2s; }
        .word-input:focus { border-color: var(--accent); }
        .word-input.error { border-color: var(--error); color: var(--error); }

        .word { display: inline-block; margin-right: 0.5rem; margin-bottom: 0.5rem; padding: 2px 4px; border-radius: 4px; transition: background 0.2s; }
        .word.active { background: rgba(226, 183, 20, 0.15); border-bottom: 2px solid var(--accent); }

        .countdown-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.8); align-items: center; justify-content: center; z-index: 100; font-size: 5rem; color: var(--accent); font-weight: bold; }
    </style>
</head>
<body>
<div class="race-container">
    <div style="color:var(--muted); font-size:0.8rem; margin-bottom:1rem;">
        kambarys: <span style="color:var(--accent)">@ViewBag.RoomId</span>
        — pasidalink šiuo kodu su draugais
    </div>

    <div id="lobby-controls" style="margin-bottom: 1.5rem;">
        <select id="difficulty-select" class="btn" style="width:auto; display:inline-block; margin-right:0.5rem; text-align: left; padding: 0.6rem;" disabled onchange="changeDifficulty()">
            <option value="easy">Easy</option>
            <option value="medium">Medium</option>
            <option value="hard">Hard</option>
        </select>
        <button id="btn-ready" class="btn" onclick="toggleReady()">Pasiruošęs</button>
        <button id="btn-start" class="btn" style="display:none;" disabled onclick="startRace()">Pradėti lenktynes</button>
    </div>

    <div class="players-bar" id="players-bar"></div>

    <div class="stats-bar" id="stats-bar">
        <span class="stat"><span id="wpm-display">0</span><label>wpm</label></span>
        <span class="stat"><span id="accuracy-display">100</span><label>%</label></span>
        <span class="stat"><span id="timer-display">0</span><label>sek</label></span>
    </div>

    <div id="text-display" class="text-display"></div>

    <div style="text-align: center;">
        <input type="text" id="input-field" class="word-input" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="Laukiama..." />
    </div>

    <div id="result-controls" style="display:none; text-align:center; margin-top: 1.5rem;">
        <button id="btn-reset" class="btn" style="display:none;" onclick="resetRoom()">Grįžti į laukiamąjį (Host)</button>
        <button class="btn" onclick="window.location.href='/'">Išeiti</button>
    </div>
</div>

<div id="countdown-overlay" class="countdown-overlay">3</div>

<script>
let TARGET_TEXT = "";
const ROOM_ID     = "@ViewBag.RoomId";
const USERNAME    = sessionStorage.getItem('username') || "@ViewBag.Username";

let isHost      = false;
let isStarted   = false;
let startTime   = null;
let timerHandle = null;
let isFinished  = false;
const klaidosSet = new Set();
let targetWords = [];
let currentWordIndex = 0;
let totalTypedChars = 0;

const players = {};
let myConnectionId = null;

const connection = new signalR.HubConnectionBuilder()
    .withUrl("/racehub")
    .withAutomaticReconnect()
    .build();

connection.on("PlayerJoined", (data) => {
    if (!players[data.connectionId]) {
        addPlayerRow(data.connectionId, data.username, false, data.isReady);
    }
    updateStartButtonState();
});

connection.on("RoomState", (data) => {
    myConnectionId = connection.connectionId;
    isHost = data.hostConnectionId === myConnectionId;

    if (data.difficulty) {
        const diffSelect = document.getElementById('difficulty-select');
        if (diffSelect) diffSelect.value = data.difficulty;
    }

    if (isHost) {
        document.getElementById('btn-start').style.display = 'inline-block';
        document.getElementById('difficulty-select').disabled = false;
    }

    data.players.forEach(p => {
        if (!players[p.connectionId]) {
            const isMe = p.connectionId === myConnectionId;
            addPlayerRow(p.connectionId, p.username + (isMe ? " (tu)" : ""), isMe, p.isReady);
            if (data.isStarted) {
                updateProgressBar(p.connectionId, p.progress);
                const wpmEl = document.getElementById('wpm-' + p.connectionId);
                if (wpmEl) wpmEl.textContent = (p.wpm || 0) + " WPM";
                const wordEl = document.getElementById('word-' + p.connectionId);
                if (wordEl) wordEl.textContent = (p.word || "...");
            }
        }
    });

    updateStartButtonState();
});

connection.on("DifficultyChanged", (diff) => {
    const diffSelect = document.getElementById('difficulty-select');
    if (diffSelect) {
        diffSelect.value = diff;
    }
});

connection.on("PlayerReadyStatus", (data) => {
    if (players[data.connectionId]) {
        players[data.connectionId].isReady = data.isReady;
        const statusEl = document.getElementById('status-' + data.connectionId);
        if (statusEl) {
            statusEl.textContent = data.isReady ? "Pasiruošęs" : "Laukiama";
            statusEl.className = 'player-status ' + (data.isReady ? 'ready' : 'not-ready');
        }

        if (data.connectionId === myConnectionId) {
            document.getElementById('btn-ready').textContent = data.isReady ? "Atšaukti pasiruošimą" : "Pasiruošęs";
        }
    }
    updateStartButtonState();
});

connection.on("RaceStarting", (data) => {
    TARGET_TEXT = data.text;
    startCountdown();
});

connection.on("ProgressUpdate", (data) => {
    updateProgressBar(data.connectionId, data.progress);
    const wpmEl = document.getElementById('wpm-' + data.connectionId);
    if (wpmEl && data.wpm !== undefined) wpmEl.textContent = data.wpm + " WPM";
    const wordEl = document.getElementById('word-' + data.connectionId);
    if (wordEl && data.word !== undefined) wordEl.textContent = data.word;
});

connection.on("PlayerFinished", (data) => {
    const row = document.getElementById('player-' + data.connectionId);
    if (row) row.classList.add('finished');
    const statsEl = document.getElementById('live-stats-' + data.connectionId);
    if (statsEl) {
        let medal = ""; let placeClass = "";
        if (data.place === 1) { medal = "🏆 "; placeClass = "place-1"; }
        else if (data.place === 2) { medal = "🥈 "; placeClass = "place-2"; }
        else if (data.place === 3) { medal = "🥉 "; placeClass = "place-3"; }
        statsEl.innerHTML = `<span class="${placeClass}" style="font-size:0.9rem; text-align:right; width:100%; border:none; background:transparent;">${medal}#${data.place} (${data.wpm} WPM)</span>`;
    }
});

connection.on("PlayerLeft", (data) => {
    const row = document.getElementById('player-' + data.connectionId);
    if (row) row.remove();
    delete players[data.connectionId];

    if (data.newHostId === myConnectionId) {
        isHost = true;
        if (!isStarted) {
            document.getElementById('btn-start').style.display = 'inline-block';
            document.getElementById('difficulty-select').disabled = false;
        } else if (isFinished) {
            document.getElementById('btn-reset').style.display = 'inline-block';
        }
    }
    updateStartButtonState();
});

connection.on("RoomReset", () => {
    isStarted = false;
    isFinished = false;
    startTime = null;
    timerHandle = null;
    klaidosSet.clear();
    currentWordIndex = 0;
    totalTypedChars = 0;

    document.getElementById('text-display').style.display = 'none';
    document.getElementById('stats-bar').style.display = 'none';
    document.getElementById('result-controls').style.display = 'none';
    document.getElementById('lobby-controls').style.display = 'block';

    if (isHost) {
        document.getElementById('difficulty-select').disabled = false;
    }

    document.getElementById('input-field').style.display = 'none';
    document.getElementById('input-field').value = '';
    document.getElementById('input-field').classList.remove('error');
    document.getElementById('input-field').disabled = false;

    document.querySelectorAll('.progress-track').forEach(el => {
        el.style.display = 'none';
        el.querySelector('.progress-fill').style.width = '0%';
    });

    document.querySelectorAll('.player-row').forEach(row => {
        row.classList.remove('finished');
        const id = row.id.replace('player-', '');
        const statsEl = document.getElementById('live-stats-' + id);
        if (statsEl) {
            statsEl.style.display = 'none';
            statsEl.innerHTML = `<span class="live-wpm" id="wpm-${id}">0 WPM</span><span class="live-word" id="word-${id}">...</span>`;
        }
    });

    document.querySelectorAll('.player-status').forEach(el => {
        el.style.display = 'inline-block';
        el.textContent = 'Laukiama';
        el.className = 'player-status not-ready';
    });

    document.getElementById('btn-ready').textContent = 'Pasiruošęs';

    for (let id in players) {
        players[id].progress = 0;
        players[id].isReady = false;
    }

    updateStartButtonState();
});

function addPlayerRow(connectionId, username, isMe, isReady) {
    const bar = document.getElementById('players-bar');
    const div = document.createElement('div');
    div.className = 'player-row' + (isMe ? ' me' : '');
    div.id = 'player-' + connectionId;
    div.innerHTML = `
        <span class="player-name">${username}</span>
        <div class="progress-track" id="track-${connectionId}">
            <div class="progress-fill" id="fill-${connectionId}"></div>
        </div>
        <div class="live-stats" id="live-stats-${connectionId}" style="display:none;">
            <span class="live-wpm" id="wpm-${connectionId}">0 WPM</span>
            <span class="live-word" id="word-${connectionId}">...</span>
        </div>
        <span class="player-status ${isReady ? 'ready' : 'not-ready'}" id="status-${connectionId}">
            ${isReady ? 'Pasiruošęs' : 'Laukiama'}
        </span>`;
    bar.appendChild(div);
    players[connectionId] = { username, progress: 0, isReady: isReady };
}

function resetRoom() {
    connection.invoke("ResetRoom", ROOM_ID);
}

function updateProgressBar(connectionId, progress) {
    const fill = document.getElementById('fill-' + connectionId);
    if (fill) fill.style.width = progress + '%';
    if (players[connectionId]) players[connectionId].progress = progress;
}

function updateStartButtonState() {
    if (!isHost) return;
    const allReady = Object.values(players).every(p => p.isReady);
    document.getElementById('btn-start').disabled = !allReady;
}

function toggleReady() {
    connection.invoke("ToggleReady", ROOM_ID);
}

function startRace() {
    connection.invoke("StartRace", ROOM_ID);
}

function startCountdown() {
    isStarted = true;
    document.getElementById('lobby-controls').style.display = 'none';

    document.querySelectorAll('.progress-track').forEach(el => el.style.display = 'block');
    document.querySelectorAll('.player-status').forEach(el => el.style.display = 'none');
    document.querySelectorAll('.live-stats').forEach(el => el.style.display = 'flex');

    renderText();

    let count = 3;
    const overlay = document.getElementById('countdown-overlay');
    overlay.style.display = 'flex';
    overlay.textContent = count;

    const interval = setInterval(() => {
        count--;
        if (count > 0) {
            overlay.textContent = count;
        } else {
            clearInterval(interval);
            overlay.style.display = 'none';
            beginTypingPhase();
        }
    }, 1000);
}

function renderText() {
    const container = document.getElementById('text-display');
    container.innerHTML = '';
    for (let i = 0; i < TARGET_TEXT.length; i++) {
        const span = document.createElement('span');
        span.className = 'char ' + (TARGET_TEXT[i] === ' ' ? 'space' : '');
        span.textContent = TARGET_TEXT[i] === ' ' ? '_' : TARGET_TEXT[i];
        container.appendChild(span);
    }
    chars = document.querySelectorAll('.char');
    document.getElementById('stats-bar').style.display = 'flex';
    container.style.display = 'block';
}

function beginTypingPhase() {
    const input = document.getElementById('input-field');
    input.style.opacity = '1';
    input.style.position = 'static';
    input.focus();
    if (chars.length > 0) chars[0].classList.add('current');
    startTime = Date.now();
    timerHandle = setInterval(updateTimer, 200);

    input.addEventListener('input', function() {
        if (isFinished) return;
        const typed = this.value;
        updateCharColors(typed);
        document.getElementById('wpm-display').textContent = calcWPM(typed.length);
        document.getElementById('accuracy-display').textContent = calcAccuracy(typed);

        if (typed === TARGET_TEXT) finishRace(typed);
    });

    document.addEventListener('click', () => { if (!isFinished) input.focus(); });
}

function updateCharColors(typed) {
    chars.forEach((span, i) => {
        span.classList.remove('correct', 'error', 'current');
        if (i < typed.length) {
            if (typed[i] === TARGET_TEXT[i]) span.classList.add('correct');
            else { span.classList.add('error'); klaidosSet.add(i); }
        } else if (i === typed.length) {
            span.classList.add('current');
        }
    });
}

function calcWPM(charsTyped) {
    if (!startTime || charsTyped === 0) return 0;
    return Math.round((charsTyped / 5) / ((Date.now() - startTime) / 60000));
}

function calcAccuracy(typed) {
    if (!typed.length) return 100;
    let correct = 0;
    for (let i = 0; i < typed.length; i++)
        if (typed[i] === TARGET_TEXT[i]) correct++;
    return Math.round((correct / typed.length) * 100);
}

function updateTimer() {
    if (!startTime) return;
    document.getElementById('timer-display').textContent = Math.floor((Date.now() - startTime) / 1000);
}

async function finishRace(typed) {
    isFinished = true;
    clearInterval(timerHandle);
    document.getElementById('input-field').disabled = true;

    const timeSeconds = Math.round((Date.now() - startTime) / 1000);
    const wpm = calcWPM(typed.length);
    const accuracy = calcAccuracy(typed);

    await connection.invoke("FinishRace", ROOM_ID, wpm, accuracy, timeSeconds);
    updateProgressBar(myConnectionId, 100);

    document.getElementById('result-controls').style.display = 'block';
    if (isHost) {
        document.getElementById('btn-reset').style.display = 'inline-block';
    }
}

let lastSentProgress = -1;
setInterval(() => {
    if (!startTime || isFinished) return;
    const typed = document.getElementById('input-field').value;
    const typedLength = totalTypedChars + typed.length;
    const progress = Math.round((typedLength / TARGET_TEXT.length) * 100);
    const currentWpm = calcWPM(typedLength);
    const currentWord = targetWords[currentWordIndex] || "";

    if (progress !== lastSentProgress || currentWpm > 0) {
        connection.invoke("UpdateProgress", ROOM_ID, progress, currentWpm, currentWord);
        lastSentProgress = progress;
    }
}, 300);

function changeDifficulty() {
    if(!isHost) return;
    const diff = document.getElementById('difficulty-select').value;
    connection.invoke("ChangeDifficulty", ROOM_ID, diff);
}

async function startConnection() {
    await connection.start();
    await connection.invoke("JoinRoom", ROOM_ID, USERNAME);
}

startConnection();
</script>
</body>
</html>