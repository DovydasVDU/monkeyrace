@model TextSnippet
@using Microsoft.AspNetCore.Http
@{
    var username = ViewContext.HttpContext.Session.GetString("Username");
}
<!DOCTYPE html>
<html>
<head>
    <script src="~/js/login.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/player.css" asp-append-version="true">
</head>
<body>
    <header class="navbar">
        <div class="logo" onclick="window.location='/'">MonkeyRacer</div>
        <div class="nav-right">
            @if (username != null)
            {
                <div class="user-menu" onclick="toggleMenu()">
                    <div class="user-icon">@username.Substring(0,1).ToUpper()</div>
                    <div class="username">@username</div>
                    <div class="dropdown" id="userDropdown">
                        <a href="/User/Stats">User Stats</a>
                        <a href="/User/Settings">Account Settings</a>
                        <a href="/Auth/Logout">Log Out</a>
                    </div>
                </div>
            }
            else
            {
                <button class="nav-btn" onclick="openLogin()">Login</button>
            }
        </div>
    </header>

    <div class="race-page">
        <div class="race-container">
        <form method="get" asp-controller="Race" asp-action="Play" style="margin-bottom: 1.5rem;">
            <select name="difficulty" onchange="this.form.submit()"
                    style="background:#16213e;color:#e8e8e3;padding:0.5rem;border-radius:4px;border:1px solid #333;">
                <option value="easy" selected="@(ViewBag.SelectedDifficulty == "easy")">Easy</option>
                <option value="medium" selected="@(ViewBag.SelectedDifficulty == "medium")">Medium</option>
                <option value="hard" selected="@(ViewBag.SelectedDifficulty == "hard")">Hard</option>
            </select>
        </form>

        <div class="race-container">
   

    <div class="stats-bar" id="stats-bar">
        <span class="stat"><span id="wpm-display">0</span><label>wpm</label></span>
        <span class="stat"><span id="accuracy-display">100</span><label>%</label></span>
        <span class="stat"><span id="timer-display">0</span><label>sek</label></span>
    </div>

    <div id="text-display" class="text-display"></div>

    <div style="text-align: center;">
        <input type="text" id="input-field" class="word-input" style="display: block;" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" placeholder="Pradėk spausdinti..." autofocus />
    </div>

        </div>
    </div>
    <div class="results-overlay" id="results-overlay">
        <div class="results-box">
            <h2>rezultatai</h2>
            <div class="results-grid">
                <div class="result-stat">
                    <span id="result-wpm">0</span>
                    <label>wpm</label>
                </div>
                <div class="result-stat">
                    <span id="result-accuracy">0</span>
                    <label>tikslumas %</label>
                </div>
                <div class="result-stat">
                    <span id="result-time">0</span>
                    <label>sekundės</label>
                </div>
                <div class="result-stat">
                    <span id="result-klaidos">0</span>
                    <label>klaidos</label>
                </div>
            </div>
            <button class="btn-restart" onclick="restartRace()">bandyti dar kartą ↺</button>
        </div>
    </div>

    <!-- LOGIN MODAL -->

    <div class="modal" id="loginModal">

    <div class="modal-box" style="position: relative;">

    <span onclick="closeLogin()" style="position: absolute; top: 1rem; right: 1rem; cursor: pointer; color: var(--muted); font-size: 1.2rem;">&times;</span>

    <h3>login</h3>

<input id="login-user" placeholder="username">
<input id="login-pass" type="password" placeholder="password">

<button class="btn" onclick="login()">login</button>
<button class="btn" onclick="register()">register</button>

</div>

</div>
    <script>
         function openLogin(){
            document.getElementById("loginModal").classList.add("visible");
            }
        function toggleMenu() {
            document.getElementById("userDropdown").classList.toggle("visible");
        }

        let TARGET_TEXT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Content));
        const RACE_ID     = @ViewBag.RaceId;

        const klaidosSet = new Set();
        let targetWords = [];
        let currentWordIndex = 0;
        let totalTypedChars = 0;

        let startTime   = null;
        let timerHandle = null;
        let isFinished  = false;

        const inputField      = document.getElementById('input-field');
        const wpmDisplay      = document.getElementById('wpm-display');
        const accuracyDisplay = document.getElementById('accuracy-display');
        const timerDisplay    = document.getElementById('timer-display');

        function renderText() {
            targetWords = TARGET_TEXT.split(' ');
            const container = document.getElementById('text-display');
            container.innerHTML = '';

            targetWords.forEach((word, index) => {
                const wordSpan = document.createElement('span');
                wordSpan.className = 'word' + (index === 0 ? ' active' : '');
                wordSpan.id = 'word-elem-' + index;

                for (let i = 0; i < word.length; i++) {
                    const charSpan = document.createElement('span');
                    charSpan.className = 'char';
                    charSpan.textContent = word[i];
                    wordSpan.appendChild(charSpan);
                }
                container.appendChild(wordSpan);
            });

            container.style.display = 'block';
        }

        function init() {
            renderText();
            inputField.focus();

            inputField.addEventListener('input', function(e) {
                if (isFinished) return;

                if (startTime === null) {
                    startTime = Date.now();
                    timerHandle = setInterval(updateTimer, 200);
                }

                let typed = this.value;
                const targetWord = targetWords[currentWordIndex];
                if (!targetWord) return;

                const isLastWord = currentWordIndex === targetWords.length - 1;

                if (typed.endsWith(' ') && !isLastWord) {
                    const typedWord = typed.trim();
                    if (typedWord === targetWord) {
                        const chars = document.getElementById('word-elem-' + currentWordIndex).querySelectorAll('.char');
                        chars.forEach(c => c.classList.add('correct'));
                        document.getElementById('word-elem-' + currentWordIndex).classList.remove('active');

                        totalTypedChars += targetWord.length + 1;
                        currentWordIndex++;

                        document.getElementById('word-elem-' + currentWordIndex).classList.add('active');
                        this.value = '';
                        this.classList.remove('error');

                        wpmDisplay.textContent = calcWPM(totalTypedChars);
                        return;
                    } else {
                        this.value = typed.trim();
                    }
                }

                typed = this.value;

                if (isLastWord && typed === targetWord) {
                    const chars = document.getElementById('word-elem-' + currentWordIndex).querySelectorAll('.char');
                    chars.forEach(c => c.classList.add('correct'));
                    totalTypedChars += targetWord.length;
                    wpmDisplay.textContent = calcWPM(totalTypedChars);
                    finishRace();
                    return;
                }

                updateCharColors(typed, targetWord);

                if (startTime !== null) {
                    wpmDisplay.textContent = calcWPM(totalTypedChars + typed.length);
                    accuracyDisplay.textContent = calcAccuracy();
                }
            });

            document.addEventListener('click', () => { if (!isFinished) inputField.focus(); });
        }

        function updateCharColors(typed, targetWord) {
            const wordElem = document.getElementById('word-elem-' + currentWordIndex);
            const charElems = wordElem.querySelectorAll('.char');
            let isError = false;

            for (let i = 0; i < charElems.length; i++) {
                charElems[i].classList.remove('correct', 'error', 'current');

                if (i < typed.length) {
                    if (typed[i] === targetWord[i]) {
                        charElems[i].classList.add('correct');
                    } else {
                        charElems[i].classList.add('error');
                        isError = true;
                        klaidosSet.add(`${currentWordIndex}-${i}`); // track unique errors
                    }
                } else if (i === typed.length) {
                    charElems[i].classList.add('current');
                }
            }

            if (typed.length > targetWord.length || isError) {
                inputField.classList.add('error');
            } else {
                inputField.classList.remove('error');
            }
        }

        function calcWPM(charsTyped) {
            if (!startTime || charsTyped === 0) return 0;
            return Math.round((charsTyped / 5) / ((Date.now() - startTime) / 60000));
        }

        function calcAccuracy() {
            let totalTarget = TARGET_TEXT.length;
            if (totalTarget === 0) return 100;
            let accuracy = Math.round(((totalTarget - klaidosSet.size) / totalTarget) * 100);
            return Math.max(0, accuracy);
        }

        function updateTimer() {
            if (!startTime) return;
            timerDisplay.textContent = Math.floor((Date.now() - startTime) / 1000);
            if (!isFinished) {
                accuracyDisplay.textContent = calcAccuracy();
            }
        }

        function finishRace() {
            isFinished = true;
            clearInterval(timerHandle);
            inputField.disabled = true;

            const timeSeconds = Math.round((Date.now() - startTime) / 1000);
            const wpm         = calcWPM(totalTypedChars);
            const accuracy    = calcAccuracy();

            document.getElementById('result-wpm').textContent      = wpm;
            document.getElementById('result-accuracy').textContent = accuracy;
            document.getElementById('result-time').textContent     = timeSeconds;
            document.getElementById('result-klaidos').textContent  = klaidosSet.size;
            document.getElementById('results-overlay').classList.add('visible');

            fetch('/Race/SaveResult', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    raceId:      RACE_ID,
                    wpm:         wpm,
                    accuracy:    accuracy,
                    timeSeconds: timeSeconds
                })
            });
        }

        function restartRace() {
            const urlParams = new URLSearchParams(window.location.search);
            const difficulty = urlParams.get("difficulty") || "medium";
            window.location.href = `/Race/Play?difficulty=${difficulty}`;
        }

        init();


        /* login */
        async function login() {

            const username = document.getElementById("login-user").value
            const password = document.getElementById("login-pass").value
            // kreipiamės į AuthController Login metodą POST užklausa, siunčiame username ir password formatu application/x-www-form-urlencoded
            const res = await fetch("/Auth/Login", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `username=${encodeURIComponent(username)}&password=${encodeURIComponent(password)}`

            })
                // AuthController grąžiną 200 OK jei login sėkmingas, kitu atveju 400 Bad Request su klaidos pranešimu

            if (res.ok)
                location.reload()
            else {
      
            let message = "login failed"

            try {
                const data = await res.json() // nuskaitome JSON iš AuthController
                message = data.message
            } catch {
                // jei ne JSON (fallback)
                message = await res.text()
            }

            alert(message)
        }

        }
        async function register() {

    const username = document.getElementById("login-user").value
    const password = document.getElementById("login-pass").value

    if (!username || !password) {
        alert("enter username and password")
        return
    }
    // kreipiamės į AuthController Register metodą POST užklausa, siunčiame username ir password formatu application/x-www-form-urlencoded
    const res = await fetch("/Auth/Register", { 
        method: "POST",
        headers: {
            "Content-Type": "application/x-www-form-urlencoded"
        },
        body: `username=${encodeURIComponent(username)}&password=${encodeURIComponent(password)}`

    })
    // AuthController grąžiną 200 OK jei registracija sėkminga, kitu atveju 400 Bad Request su klaidos pranešimu
    if (res.ok) {
        alert("account created")
        location.reload()
    }
    else {

        
        let message = "register failed"

        try {
            const data = await res.json() // n uskaitome JSON iš AuthController
            message = data.message
        } catch {
            // jei ne JSON (fallback)
            message = await res.text()
        }

        alert(message)
    }
}
    </script>
</body>
</html>