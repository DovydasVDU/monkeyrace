// Hubs/RaceHub.cs
using Microsoft.AspNetCore.SignalR;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;

public class RaceHub : Hub
{
    private readonly AppDbContext _db;

    // Statinis žodynas – gyvas kol veikia serveris
    // roomId → sąrašas žaidėjų toje patalpoje
    private static readonly Dictionary<string, List<RoomPlayer>> _rooms
        = new Dictionary<string, List<RoomPlayer>>();

    // Objektas apsaugo nuo race condition kai keli žaidėjai
    // prisijungia tuo pačiu metu
    private static readonly object _lock = new object();

    public RaceHub(AppDbContext db)
    {
        _db = db;
    }

    // -------------------------------------------------------
    // Prisijungimas prie kambario
    // Kviečiama iš JavaScript: connection.invoke("JoinRoom", roomId)
    // -------------------------------------------------------
    public async Task JoinRoom(string roomId, string username)
    {
        // Pridedame šį ryšį prie SignalR grupės
        // Grupė = visi ryšiai kurie gauna tas pačias žinutes
        await Groups.AddToGroupAsync(Context.ConnectionId, roomId);

        var player = new RoomPlayer
        {
            ConnectionId = Context.ConnectionId,
            Username = username,
            Progress = 0,
            IsFinished = false,
            JoinedAt = DateTime.UtcNow
        };

        lock (_lock)
        {
            if (!_rooms.ContainsKey(roomId))
                _rooms[roomId] = new List<RoomPlayer>();

            _rooms[roomId].Add(player);
        }

        // Pranešame VISIEMS kambaryje apie naują žaidėją
        // "PlayerJoined" – JavaScript funkcijos pavadinimas kurią iškviesime
        await Clients.Group(roomId).SendAsync("PlayerJoined", new
        {
            connectionId = Context.ConnectionId,
            username = username,
            playerCount = _rooms[roomId].Count
        });

        // Naujam žaidėjui siunčiame visų esamų žaidėjų sąrašą
        await Clients.Caller.SendAsync("RoomState", new
        {
            players = _rooms[roomId].Select(p => new
            {
                connectionId = p.ConnectionId,
                username = p.Username,
                progress = p.Progress
            })
        });
    }

    // -------------------------------------------------------
    // Progreso atnaujinimas (siunčiamas kas ~300ms)
    // -------------------------------------------------------
    public async Task UpdateProgress(string roomId, int progressPercent)
    {
        lock (_lock)
        {
            var room = _rooms.ContainsKey(roomId) ? _rooms[roomId] : null;
            if (room == null) return;

            var player = room.FirstOrDefault(
                p => p.ConnectionId == Context.ConnectionId);
            if (player != null)
                player.Progress = progressPercent;
        }

        // Siunčiame visiems kambaryje – įskaitant siuntėją
        await Clients.Group(roomId).SendAsync("ProgressUpdate", new
        {
            connectionId = Context.ConnectionId,
            progress = progressPercent
        });
    }

    // -------------------------------------------------------
    // Žaidėjas baigė tekstą
    // -------------------------------------------------------
    public async Task FinishRace(string roomId, int wpm, double accuracy, int timeSeconds)
    {
        int place = 1;

        lock (_lock)
        {
            var room = _rooms.ContainsKey(roomId) ? _rooms[roomId] : null;
            if (room != null)
            {
                // Vieta = kiek žaidėjų jau baigė + 1
                place = room.Count(p => p.IsFinished) + 1;

                var player = room.FirstOrDefault(
                    p => p.ConnectionId == Context.ConnectionId);
                if (player != null)
                {
                    player.IsFinished = true;
                    player.Progress = 100;
                    player.WPM = wpm;
                    player.Place = place;
                }
            }
        }

        // Pranešame visiems kas baigė ir kokia vieta
        await Clients.Group(roomId).SendAsync("PlayerFinished", new
        {
            connectionId = Context.ConnectionId,
            place = place,
            wpm = wpm
        });
    }

    // -------------------------------------------------------
    // Automatinis valymas kai žaidėjas atsijungia
    // Kviečiama SignalR automatiškai
    // -------------------------------------------------------
    public override async Task OnDisconnectedAsync(Exception exception)
    {
        string roomToNotify = null;

        lock (_lock)
        {
            foreach (var room in _rooms)
            {
                var player = room.Value.FirstOrDefault(
                    p => p.ConnectionId == Context.ConnectionId);
                if (player != null)
                {
                    room.Value.Remove(player);
                    roomToNotify = room.Key;

                    // Tuščią kambarį išvalom
                    if (room.Value.Count == 0)
                        _rooms.Remove(room.Key);
                    break;
                }
            }
        }

        if (roomToNotify != null)
        {
            await Clients.Group(roomToNotify).SendAsync("PlayerLeft", new
            {
                connectionId = Context.ConnectionId
            });
        }

        await base.OnDisconnectedAsync(exception);
    }
}

// Žaidėjo duomenys kambaryje
public class RoomPlayer
{
    public string ConnectionId { get; set; }
    public string Username { get; set; }
    public int Progress { get; set; }  // 0-100%
    public bool IsFinished { get; set; }
    public int WPM { get; set; }
    public int Place { get; set; }
    public DateTime JoinedAt { get; set; }
}