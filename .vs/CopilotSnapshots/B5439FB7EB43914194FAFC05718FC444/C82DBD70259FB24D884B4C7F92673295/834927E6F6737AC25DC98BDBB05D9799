@* Views/Race/Lobby.cshtml *@
@model TextSnippet
@using Microsoft.AspNetCore.Http
@{
    var username = ViewContext.HttpContext.Session.GetString("Username");
}
<!DOCTYPE html>
<html>
<head>
    <title>MonkeyRacer – Multiplayer</title>
    <style>
        /* tas pats stilius kaip Play.cshtml */
        :root { --bg:#1a1a2e; --surface:#16213e;
                --accent:#e2b714; --text:#d1d0c5; --muted:#646669; }
        * { margin:0; padding:0; box-sizing:border-box; }
        body { background:var(--bg); color:var(--text);
               font-family:'Courier New',monospace;
               display:flex; align-items:center;
               justify-content:center; min-height:100vh; }
        .container { max-width:500px; width:100%; padding:2rem; text-align:center; }
        h1 { color:var(--accent); margin-bottom:2rem; font-size:2rem; }
        .input-group { margin-bottom:1rem; }
        input, select {
            width:100%; padding:0.8rem; background:var(--surface);
            border:1px solid #333; border-radius:4px;
            color:var(--text); font-family:inherit; font-size:1rem;
        }
        .btn {
            width:100%; padding:0.8rem; margin-top:0.5rem;
            background:transparent; border:1px solid var(--accent);
            color:var(--accent); font-family:inherit; font-size:1rem;
            border-radius:4px; cursor:pointer; transition:all 0.2s;
        }
        .btn:hover { background:var(--accent); color:var(--bg); }
        .or { color:var(--muted); margin:1rem 0; }
    </style>
</head>
<body>
<div class="container">
    <h1>multiplayer</h1>

    @{
    if (username != null)
    {
        <div style="color:var(--muted); margin-bottom:1rem;">
            esate prisijungęs kaip <span style="color:var(--accent)">@username</span>
        </div>
    } else {
        <div class="input-group">
        <input id="username-input" placeholder="tavo vardas" maxlength="20" />
    </div>
}
    
    <div class="input-group">
        <select id="difficulty-select">
            <option value="easy">easy</option>
            <option value="medium" selected>medium</option>
            <option value="hard">hard</option>
        </select>
    </div>

    <button class="btn" onclick="createRoom()">sukurti kambarį</button>
    <div class="or">— arba —</div>
    <div class="input-group">
        <input id="room-id-input" placeholder="įvesk kambario kodą" />
    </div>
    <button class="btn" onclick="joinRoom()">prisijungti</button>
</div>

<script>
    function createRoom() {
        // Generuojame atsitiktinį 6 simbolių kodo kambarį
        const roomId = Math.random().toString(36).substring(2, 8).toUpperCase();
        redirect(roomId);
    }

    function joinRoom() {
        const roomId = document.getElementById('room-id-input').value.trim();
        if (!roomId) return alert('Įvesk kambario kodą');
        redirect(roomId);
    }

    function redirect(roomId) {
        const username   = document.getElementById('username-input').value.trim() || 'Svečias';
        const difficulty = document.getElementById('difficulty-select').value;
        sessionStorage.setItem('username', username);
        window.location.href =
            `/Race/MultiPlay?roomId=${roomId}&difficulty=${difficulty}`;
    }
</script>
</body>
</html>