@using Microsoft.AspNetCore.Http
@{
    var username = ViewContext.HttpContext.Session.GetString("Username");
}

<!DOCTYPE html>
<html>
<head>
<title>MonkeyRacer</title>

<style>

:root{
--bg:#1a1a2e;
--surface:#16213e;
--accent:#e2b714;
--text:#ffffff;
--muted:#646669;
}

*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
background:var(--bg);
color:var(--text);
font-family:'Courier New', monospace;
min-height:100vh;
}

/* ---------------- NAVBAR ---------------- */

.navbar{
display:flex;
justify-content:space-between;
align-items:center;
padding:1.2rem 2rem;
border-bottom:1px solid #2a2a3f;
width: 100%;
}

.logo{
font-size:1.4rem;
font-weight:bold;
color:var(--accent);
cursor:pointer;
}

.nav-right{
display:flex;
align-items:center;
gap:1rem;
}

.nav-btn{
border:1px solid var(--accent);
background:transparent;
color:var(--accent);
padding:0.45rem 1.3rem;
border-radius:5px;
cursor:pointer;
font-size:0.9rem;
transition:all .2s;
}

.nav-btn:hover{
background:var(--accent);
color:var(--bg);
}

/* USER MENU */

.user-menu{
display:flex;
align-items:center;
gap:.5rem;
cursor:pointer;
position:relative;
}

.user-icon{
width:30px;
height:30px;
border-radius:50%;
background:var(--accent);
display:flex;
align-items:center;
justify-content:center;
color:#000;
font-weight:bold;
}

.username{
color:var(--text);
}

.dropdown{
position:absolute;
top:40px;
right:0;
background:var(--surface);
border:1px solid #333;
border-radius:8px;
width:180px;
display:none;
flex-direction:column;
}

.dropdown a{
padding:.7rem 1rem;
color:var(--text);
text-decoration:none;
border-bottom:1px solid #2a2a2a;
}

.dropdown a:hover{
background:#1d2748;
}

.dropdown.visible{
display:flex;
}

/* ---------------- HOME ---------------- */

.home-container{
display:flex;
justify-content:center;
align-items:center;
height:80vh;
gap:4rem;
}

/* GAME CARDS */

.card{
background:var(--surface);
border:1px solid #333;
border-radius:12px;
width:320px;
padding:2.5rem;
text-align:center;
transition:transform .2s, box-shadow .2s;
cursor:pointer;
}

.card:hover{
transform:translateY(-6px);
box-shadow:0 8px 25px rgba(0,0,0,0.4);
}

.card h2{
color:var(--accent);
font-size:1.1rem;
letter-spacing:.15em;
margin-bottom:2rem;
}

.card p{
color:var(--muted);
font-size:.85rem;
margin-bottom:1.5rem;
}

.btn{
width:100%;
margin-top:.6rem;
padding:.7rem;
border-radius:5px;
border:1px solid var(--accent);
background:transparent;
color:var(--accent);
cursor:pointer;
font-size:.9rem;
transition:all .2s;
}

.btn:hover{
background:var(--accent);
color:var(--bg);
}

/* LOGIN MODAL */

.modal{
position:fixed;
inset:0;
background:rgba(0,0,0,0.75);
display:none;
justify-content:center;
align-items:center;
}

.modal.visible{
display:flex;
}

.modal-box{
background:var(--surface);
border:1px solid #333;
border-radius:10px;
padding:2rem;
width:320px;
}

.modal-box h3{
margin-bottom:1rem;
color:var(--accent);
}

.modal-box input{
width:100%;
margin-bottom:.8rem;
padding:.6rem;
background:#111;
border:1px solid #333;
color:white;
border-radius:4px;
}

</style>
</head>

<body>

<!-- NAVBAR -->

<header class="navbar">

<div class="logo">MonkeyRacer</div>

<div class="nav-right">

@if(username != null)
{
<div class="user-menu" onclick="toggleMenu()">

<div class="user-icon">
@username.Substring(0,1).ToUpper()
</div>

<div class="username">@username</div>

<div class="dropdown" id="userDropdown">

<a href="/User/Stats">User Stats</a>
<a href="/User/Settings">Account Settings</a>
<a href="/Auth/Logout">Log Out</a>

</div>

</div>
}
else
{
<button class="nav-btn" onclick="openLogin()">Login</button>
}

</div>

</header>


<!-- MAIN -->

<div class="home-container">

<!-- SOLO TEST -->

<div class="card" onclick="startSolo()">

<h2>SOLO TEST</h2>

<p>Practice your typing speed and accuracy.</p>

<button class="btn">Start Race</button>

</div>


<!-- ONLINE RACE -->

<div class="card">

<h2>ONLINE RACE</h2>

<p>Race against other players in real time.</p>

<button class="btn" onclick="joinRoom()">Join Room</button>
<button class="btn" onclick="createRoom()">Create Room</button>

</div>

</div>


<!-- LOGIN MODAL -->

<div class="modal" id="loginModal">

<div class="modal-box">

<h3>login</h3>

<input id="login-user" placeholder="username">
<input id="login-pass" type="password" placeholder="password">

<button class="btn" onclick="login()">login</button>
<button class="btn" onclick="register()">register</button>

</div>

</div>



    <script>

        function openLogin(){
            document.getElementById("loginModal").classList.add("visible");
            }

            function toggleMenu(){
            document.getElementById("userDropdown").classList.toggle("visible");
            }

            function startSolo(){
            window.location="/Race/Play";
        }

        /* ROOM LOGIC */

        function createRoom() {

            const id = Math.random().toString(36).substring(2, 8)

            window.location.href = "/Race/Lobby"
        }

        function joinRoom() {

            const id = prompt("Enter room id")

            if (id)
                window.location.href = "/Race/MultiPlay?roomId=" + id
        }

        /* login */
        async function login() {

            const username = document.getElementById("login-user").value
            const password = document.getElementById("login-pass").value
            // kreipiamės į AuthController Login metodą POST užklausa, siunčiame username ir password formatu application/x-www-form-urlencoded
            const res = await fetch("/Auth/Login", {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },
                body: `username=${encodeURIComponent(username)}&password=${encodeURIComponent(password)}`

            })
                // AuthController grąžiną 200 OK jei login sėkmingas, kitu atveju 400 Bad Request su klaidos pranešimu

            if (res.ok)
                location.reload()
            else {
      
            let message = "login failed"

            try {
                const data = await res.json() // nuskaitome JSON iš AuthController
                message = data.message
            } catch {
                // jei ne JSON (fallback)
                message = await res.text()
            }

            alert(message)
        }

        }
        async function register() {

    const username = document.getElementById("login-user").value
    const password = document.getElementById("login-pass").value

    if (!username || !password) {
        alert("enter username and password")
        return
    }
    // kreipiamės į AuthController Register metodą POST užklausa, siunčiame username ir password formatu application/x-www-form-urlencoded
    const res = await fetch("/Auth/Register", { 
        method: "POST",
        headers: {
            "Content-Type": "application/x-www-form-urlencoded"
        },
        body: `username=${encodeURIComponent(username)}&password=${encodeURIComponent(password)}`

    })
    // AuthController grąžiną 200 OK jei registracija sėkminga, kitu atveju 400 Bad Request su klaidos pranešimu
    if (res.ok) {
        alert("account created")
        location.reload()
    }
    else {

        
        let message = "register failed"

        try {
            const data = await res.json() // n uskaitome JSON iš AuthController
            message = data.message
        } catch {
            // jei ne JSON (fallback)
            message = await res.text()
        }

        alert(message)
    }
}


    </script>



</body>
</html>
