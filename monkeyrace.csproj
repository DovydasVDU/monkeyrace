<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
   		<TargetFramework>net10.0</TargetFramework>	
		<RootNamespace>monkeyrace</RootNamespace>
		<!-- testų projektas gyvena tests/ aplanke ir neturi būti kompiliuojamas kartu su svetaine -->
		<DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		  <PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- WordService ir TextImporter skaito iš Data/ šalia dll -->
		<None Include="Data\words-lt.txt" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Data\texts-lt.jsonl" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Data\lesson-words.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>