@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@{ var username = User.FindFirstValue(ClaimTypes.Name);  }
@{ ViewData["Title"] = "MonkeyRace"; }
<!DOCTYPE html>
<html>

<head>
    <title>MonkeyRacer</title>

    <link rel="stylesheet" href="/css/site.css">
    <link rel="stylesheet" href="/css/login.css">

    <style>
        /* ---------------- HOME ---------------- */
        .home-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 60vh;
            gap: 4rem;
            margin-top: 80px;
        }

        /* GAME CARDS */
        .card {
            display: flex;
            flex-direction:column;
            justify-content:center;
            background: var(--surface);
            border: 1px solid #333;
            border-radius: 12px;
            width: 420px;
            height: 400px;
            padding: 2.5rem;
            text-align: center;
            transition: transform .2s, box-shadow .2s;
            cursor: pointer;
        }

            .card:hover {
                transform: translateY(-6px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.4);
            }

            .card h2 {
                color: var(--accent);
                font-size: 1.1rem;
                letter-spacing: .15em;
                margin-bottom: 2rem;
            }

            .card p {
                color: var(--muted);
                font-size: .85rem;
                margin-bottom: 1.5rem;
            }

        .card-input {
            width: 100%;
            margin-bottom: .8rem;
            padding: .6rem;
            background: #111;
            border: 1px solid #333;
            color: white;
            border-radius: 4px;
            font-family: inherit;
            text-align: center;
        }


        .leaderboard-container {
            width: 600px;
            margin: auto;
            background: var(--surface);
            border-radius: 12px;
            padding: 1.5rem;
            border: 1px solid #333;
        }

            .leaderboard-container h3 {
                text-align: center;
                color: var(--accent);
                margin-bottom: 1rem;
                letter-spacing: .1em;
            }

        .leaderboard-table {
            width: 100%;
            border-collapse: collapse;
            font-size: .9rem;
        }

            .leaderboard-table th,
            .leaderboard-table td {
                padding: .6rem;
                text-align: center;
                border-bottom: 1px solid #2a2a2a;
            }

            .leaderboard-table tr:hover {
                background: rgba(255, 255, 255, 0.03);
            }

        .rank-1 {
            color: gold;
        }

        .rank-2 {
            color: silver;
        }

        .rank-3 {
            color: #cd7f32;
        }

        .main-layout {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        /* kad kortelės būtų vienoje eilėje */
        .home-container {
            display: flex;
            justify-content: center;
            gap: 4rem;
            margin-top: 80px;
        }

        .icon-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0.5rem;
            border-radius: 8px; /* makes it look like a nice square/circle */
        }
    </style>

</head>

<body>

    <!-- MAIN -->
    <div class="main-layout">
        <div class="home-container">

            <!-- SOLO TEST -->

            <div class="card" onclick="startSolo()">

                <h2>SOLO ŽAIDIMAS</h2>

                <p>Treniruok savo spausdinimo greitį ir tikslumą.</p>

                <button class="btn">Pradėti</button>

            </div>

            <!-- ONLINE RACE -->

            <div class="card">

                <h2>ŽAISTI SU DRAUGAIS</h2>

                @if (username != null)
                {
    <p style="margin-bottom:.8rem;">Žaidžiama kaip <span style="color:var(--accent)">@username</span></p>
                    <input type="hidden" id="username-input" value="@username" /> }
                else
                {
    <input id="username-input" class="card-input" placeholder="Jūsų vardas (neprivaloma)" maxlength="20" />}

                <button class="btn" onclick="createRoom()">Sukurti kambarį</button>

                <div style="color:var(--muted); margin:.8rem 0; font-size:.85rem;">— ARBA —</div>

                <input id="room-id-input" class="card-input" placeholder="Įveskite kambario ID" />
                <button class="btn" onclick="joinRoom()">Prisijungti prie kambario</button>

            </div>

        </div>
    </div>
    <div class="leaderboard-container">

        <h3>Top 10 Žaidėjų</h3>

        <table class="leaderboard-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Žaidėjas</th>
                    <th>Žodžiai per minutę</th>
                    <th>Tikslumas</th>
                    <th>Data</th>
                </tr>
            </thead>
            <tbody id="top10-body">
            </tbody>
        </table>

    </div>

    <script>
      
      function startSolo() {
        window.location = "/Race/Play";
      }
      /* ROOM LOGIC */
      function createRoom() {
        const roomId = Math.random().toString(36).substring(2, 8).toUpperCase();
        redirectToRoom(roomId);
      }

      function joinRoom() {
        const roomId = document.getElementById('room-id-input').value.trim();
        if (!roomId) return alert('Įveskite kambario ID');
        redirectToRoom(roomId);
      }

      function redirectToRoom(roomId) {
          // jeigu user yra neprisijungęs, tada paimame vardą iš inputo, jeigu įvestas, arba naudojame "Svečias"
        const usernameInput = document.getElementById('username-input');
        let username = usernameInput ? usernameInput.value.trim() : "";
        // jeigu nieko neįvesta -> "Svečias"
        // jeigu įvesta -> pridėti "(Svečias)"
        if (username) { // tikrinam, ar įvedė kažką (username yra ne "")
            username = `${username} (Svečias)`;
        } else {
            username = "Svečias";
        }
        sessionStorage.setItem('username', username);
        window.location.href = `/Race/MultiPlay?roomId=${roomId}`;
      }
      async function loadTop10() {
        try {
          const res = await fetch('/api/stats/top10/');
          const data = await res.json();
          const tbody = document.getElementById('top10-body');
          tbody.innerHTML = "";
          data.forEach((user, index) => {
            const tr = document.createElement('tr');
            if (index === 0) tr.classList.add('rank-1');
            if (index === 1) tr.classList.add('rank-2');
            if (index === 2) tr.classList.add('rank-3');
            tr.innerHTML = `
                <td>${index + 1}</td>
                <td>${user.username}</td>
                <td>${user.wpm}</td>
                <td>${user.accuracy}%</td>
                <td>${user.date}</td>
            `;
            tbody.appendChild(tr);
          });
        } catch (err) {
          console.error("Failed to load top10", err);
        }
      }
      loadTop10();
      
    </script>
</body>

</html>