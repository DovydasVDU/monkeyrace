@using Microsoft.AspNetCore.Http
@{
    var username = ViewContext.HttpContext.Session.GetString("Username");
}

<!DOCTYPE html>
<html>
<head>
<title>MonkeyRacer</title>


<style>

:root{
--bg:#1a1a2e;
--surface:#16213e;
--accent:#e2b714;
--text:#ffffff;
--muted:#646669;
}

*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
background:var(--bg);
color:var(--text);
font-family:'Courier New', monospace;
min-height:100vh;
}




/* ---------------- HOME ---------------- */

.home-container{
display:flex;
justify-content:center;
align-items:center;
height:60vh;
gap:4rem;
margin-top: 80px;
}

/* GAME CARDS */

.card{
background:var(--surface);
border:1px solid #333;
border-radius:12px;
width:320px;
padding:2.5rem;
text-align:center;
transition:transform .2s, box-shadow .2s;
cursor:pointer;
}

.card:hover{
transform:translateY(-6px);
box-shadow:0 8px 25px rgba(0,0,0,0.4);
}

.card h2{
color:var(--accent);
font-size:1.1rem;
letter-spacing:.15em;
margin-bottom:2rem;
}

.card p{
color:var(--muted);
font-size:.85rem;
margin-bottom:1.5rem;
}

.card-input {
width:100%;
margin-bottom:.8rem;
padding:.6rem;
background:#111;
border:1px solid #333;
color:white;
border-radius:4px;
font-family:inherit;
text-align:center;
}

.btn{
width:100%;
margin-top:.6rem;
padding:.7rem;
border-radius:5px;
border:1px solid var(--accent);
background:transparent;
color:var(--accent);
cursor:pointer;
font-size:.9rem;
transition:all .2s;
}

.btn:hover{
background:var(--accent);
color:var(--bg);
}

.leaderboard-container{
width: 600px;
margin: 2rem auto;
background: var(--surface);
border-radius: 12px;
padding: 1.5rem;
border: 1px solid #333;
}

.leaderboard-container h3{
text-align:center;
color:var(--accent);
margin-bottom:1rem;
letter-spacing:.1em;
}

.leaderboard-table{
width:100%;
border-collapse:collapse;
font-size:.9rem;
}

.leaderboard-table th,
.leaderboard-table td{
padding:.6rem;
text-align:center;
border-bottom:1px solid #2a2a2a;
}

.leaderboard-table tr:hover{
background:rgba(255,255,255,0.03);
}

.rank-1 { color: gold; }
.rank-2 { color: silver; }
.rank-3 { color: #cd7f32; }
.quick-stats{
font-size:.7rem;
color:var(--muted);
margin-top:2px;
text-align:right;
}
.main-layout{
display:flex;
flex-direction:column;
align-items:center;
}

/* kad kortelės būtų vienoje eilėje */
.home-container{
display:flex;
justify-content:center;
gap:4rem;
margin-top:80px;
}
</style>
<link rel="stylesheet" href="/css/login.css">
</head>

<body>

<!-- NAVBAR -->

<header class="navbar">

<div class="logo">MonkeyRacer</div>

<div class="nav-right">

@if(username != null)
{
<div class="user-menu" onclick="toggleMenu()">

<div class="user-icon">
@username.Substring(0,1).ToUpper()
</div>

<div class="username">@username</div>
<div id="quick-stats" class="quick-stats"></div>
<div class="dropdown" id="userDropdown">

<a href="/User/Stats">Statistika</a>
<a href="/User/Settings">Paskyros nustatymai</a>
<a href="/Auth/Logout">Atsijungti</a>

</div>

</div>
}
else
{
<button class="nav-btn" onclick="openLogin()">Login</button>
}

</div>

</header>


<!-- MAIN -->
<div class="main-layout">
<div class="home-container">

<!-- SOLO TEST -->

<div class="card" onclick="startSolo()">

<h2>SOLO ŽAIDIMAS</h2>

<p>Treniruok savo spausdinimo greitį ir tikslumą.</p>

<button class="btn">Pradėti</button>

</div>


<!-- ONLINE RACE -->

<div class="card">

<h2>ŽAISTI SU DRAUGAIS</h2>

@if(username != null)
{
<p style="margin-bottom:.8rem;">Žaidžiama kaip <span style="color:var(--accent)">@username</span></p>
<input type="hidden" id="username-input" value="@username" />
}
else
{
<input id="username-input" class="card-input" placeholder="Jūsų vardas (neprivaloma)" maxlength="20" />
}

<button class="btn" onclick="createRoom()">Sukurti kambarį</button>

<div style="color:var(--muted); margin:.8rem 0; font-size:.85rem;">— ARBA —</div>

<input id="room-id-input" class="card-input" placeholder="Įveskite kambario ID" />
<button class="btn" onclick="joinRoom()">Prisijungti prie kambario</button>

</div>

</div>
</div>
<div class="leaderboard-container">

    <h3>Top 10 Žaidėjų</h3>

    <table class="leaderboard-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Žaidėjas</th>
                <th>Žodžiai per minutę</th>
                <th>Tikslumas</th>
            </tr>
        </thead>
        <tbody id="top10-body">
        </tbody>
    </table>

</div>

<!-- LOGIN MODAL -->

<div class="modal" id="loginModal">

<div class="modal-box" style="position: relative;">

<span onclick="closeLogin()" style="position: absolute; top: 1rem; right: 1rem; cursor: pointer; color: var(--muted); font-size: 1.2rem;">&times;</span>

<h3>Prisijungimas</h3>

<input id="login-user" placeholder="slapyvardis">
<input id="login-pass" type="password" placeholder="slaptažodis">

<button class="btn" onclick="login()">Prisijungti</button>
<button class="btn" onclick="register()">Registruotis</button>

</div>

</div>



    <script src="/js/login.js"></script>
    <script>



                    function toggleMenu() {
                        document.getElementById("userDropdown").classList.toggle("visible");
                    }

                    function startSolo(){
                        window.location="/Race/Play";
                    }

                    /* ROOM LOGIC */

                    function createRoom() {
                        const roomId = Math.random().toString(36).substring(2, 8).toUpperCase();
                        redirectToRoom(roomId);
                    }

                    function joinRoom() {
                        const roomId = document.getElementById('room-id-input').value.trim();
                        if (!roomId) return alert('Įveskite kambario ID');
                        redirectToRoom(roomId);
                    }

                    function redirectToRoom(roomId) {
                        const usernameInput = document.getElementById('username-input');
                        const username = (usernameInput ? usernameInput.value.trim() : "") || 'Svečias';

                        sessionStorage.setItem('username', username);
                        window.location.href = `/Race/MultiPlay?roomId=${roomId}`;
                    }
                    async function loadTop10(){
    try{
        const res = await fetch('/api/stats/top10/');
        const data = await res.json();

        const tbody = document.getElementById('top10-body');
        tbody.innerHTML = "";

        data.forEach((user, index) => {
            const tr = document.createElement('tr');

            if(index === 0) tr.classList.add('rank-1');
            if(index === 1) tr.classList.add('rank-2');
            if(index === 2) tr.classList.add('rank-3');

            tr.innerHTML = `
                <td>${index + 1}</td>
                <td>${user.username}</td>
                <td>${user.wpm}</td>
                <td>${user.accuracy}%</td>
            `;

            tbody.appendChild(tr);
        });

    }catch(err){
        console.error("Failed to load top10", err);
    }
}

loadTop10();
async function loadMyStats(){
    const username = "@username";
    if(!username) return;

    try{
        const res = await fetch(`/api/stats/${username}`);
        const data = await res.json();

        document.getElementById('quick-stats').innerHTML =
            `WPM: ${data.wpm} | Acc: ${data.accuracy}%`;

    }catch(err){
        console.error("Failed to load user stats", err);
    }
}

loadMyStats();
                </script>
            </body>
            </html>
