@using System.Security.Claims
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "MonkeyRace";
    var currentUser = User.FindFirstValue(ClaimTypes.Name);
}

<div class="home">
    <section class="home-hero">
        <p class="eyebrow">Spausdinimo lenktynės lietuvių kalba</p>
        <h1>Lenktyniauk su kitais ir treniruok rašymo greitį</h1>
        <p class="home-lead">Rašyk lietuviškus tekstus, varžykis realiu laiku, rink XP ir bananus.</p>
        <div class="home-hero-row">
            <span class="chip"><svg class="icon" aria-hidden="true"><use href="#icon-users"></use></svg>2–4 žaidėjai</span>
            <span class="chip"><svg class="icon" aria-hidden="true"><use href="#icon-target"></use></svg>Lygis pagal tave</span>
            <a class="btn btn-g" href="/Race/Play">
                <svg class="ui-icon" aria-hidden="true"><use href="#icon-keyboard"></use></svg>Solo treniruotė
            </a>
        </div>
    </section>

    <a class="play-card" href="/race/quick">
        <div class="play-card-copy">
            <span class="play-card-tag">Daugelio žaidėjų režimas</span>
            <h2>Žaisti internetu</h2>
            <p>Sistema per kelias sekundes suras 2–4 panašaus lygio varžovus. Kas pirmas finišuos be klaidų, laimės.</p>
        </div>
        <div class="play-card-side">
            <div class="play-card-art" aria-hidden="true">
                <span class="play-card-monkey">@await Html.PartialAsync("_Monkey", new MonkeyViewModel { HatColor = "#2E8B4F", Mood = "run" })</span>
                <span class="play-card-banana">@await Html.PartialAsync("_Banana")</span>
            </div>
            <span class="play-card-btn">
                <svg class="ui-icon" aria-hidden="true"><use href="#icon-play"></use></svg>Žaisti
            </span>
        </div>
    </a>

    <section class="home-section" aria-labelledby="modes-title">
        <h2 id="modes-title" class="section-title">Kiti režimai</h2>
        <div class="mode-grid">
            <article class="card mode-card">
                <h3 class="bot-mode-title">
                    <span class="bot-mode-monkey" aria-hidden="true">@await Html.PartialAsync("_Monkey", new MonkeyViewModel { HatColor = "#7E57C2" })</span>
                    Lenktyniauk su botais
                </h3>
                <p>Trys botai, kiekvienas su savo charakteriu: prisitaikantis, lengvas, vidutinis ar sunkus.</p>
                <div class="mode-actions">
                    <a class="btn btn-p" id="bots-play" href="/race/bots?levels=adaptive,adaptive,adaptive">Žaisti</a>
                    <button class="btn btn-s" type="button" id="bots-settings-open">Botų nustatymai</button>
                </div>
            </article>

            <article class="card mode-card">
                <span class="mode-icon"><svg class="ui-icon" aria-hidden="true"><use href="#icon-keyboard"></use></svg></span>
                <h3>Solo treniruotė</h3>
                <p>Treniruok greitį ir tikslumą savo tempu, be varžovų.</p>
                <a class="btn btn-p" href="/Race/Play">Pradėti</a>
            </article>

            <article class="card mode-card">
                <span class="mode-icon"><svg class="ui-icon" aria-hidden="true"><use href="#icon-clock"></use></svg></span>
                <h3>Dažniausi žodžiai</h3>
                <p>Atsitiktiniai žodžiai iš 1000 dažniausių lietuviškų. Rašyk, kol baigsis laikas.</p>
                <div class="tm-group" role="group" aria-label="Trukmė">
                    @foreach (var seconds in WordService.AllowedSeconds)
                    {
                        <button class="tm" type="button" data-words-seconds="@seconds"
                                aria-pressed="@(seconds == 30 ? "true" : "false")">@(seconds < 60 ? $"{seconds} s" : $"{seconds / 60} min")</button>
                    }
                </div>
                <div class="mode-actions">
                    <a class="btn btn-p" id="words-solo" href="/race/words?seconds=30">Solo</a>
                    <a class="btn btn-s" id="words-online" href="/race/quick?seconds=30">Online</a>
                </div>
            </article>

            <article class="card mode-card" id="friends">
                <span class="mode-icon"><svg class="ui-icon" aria-hidden="true"><use href="#icon-users"></use></svg></span>
                <h3>Su draugais</h3>
                <p>Sukurk privatų kambarį ir pasidalink kodu. Lenktynes pradeda kambario kūrėjas.</p>
                @* pakvietimo nuoroda be vardo grąžina čia su ?room=KODAS *@
                <form class="friends-form" method="get" action="/race/room/join">
                    @if (currentUser == null)
                    {
                        <label class="friends-field">Tavo vardas
                            <input name="username" maxlength="20" required autocomplete="nickname"
                                   placeholder="Kaip tave atpažins draugai" value="@Context.Session.GetString("MatchmakingUsername")">
                        </label>
                    }
                    <button class="btn btn-p" type="submit" formaction="/race/room/create" id="room-create">
                        <svg class="ui-icon" aria-hidden="true"><use href="#icon-users"></use></svg>Sukurti kambarį
                    </button>
                    <div class="friends-join">
                        <input name="code" id="room-code-input" maxlength="@MatchmakingService.CodeLength"
                               placeholder="Kodas" aria-label="Kambario kodas" autocomplete="off"
                               value="@Context.Request.Query["room"]">
                        <button class="btn btn-s" type="submit" id="room-join">Prisijungti</button>
                    </div>
                </form>
            </article>
        </div>
    </section>

    @{
        // vardai ir spalvos sutampa su MatchmakingService.BotNames ir MultiPlay beždžionių šablonais
        var botSettings = new[]
        {
            (Name: "Bambukas", Body: "#5D4037", Hat: "#E53935"),
            (Name: "Koko", Body: "#8B5E3C", Hat: "#2E8B4F"),
            (Name: "Mango", Body: "#795548", Hat: "#7E57C2")
        };
        var botLevels = new[]
        {
            (Value: "adaptive", Label: "Prisitaikantis"),
            (Value: "easy", Label: "Lengvas"),
            (Value: "medium", Label: "Vidutinis"),
            (Value: "hard", Label: "Sunkus")
        };
    }
    <dialog class="modal-box bot-dialog" id="bots-settings" aria-labelledby="bots-settings-title">
        <button class="modal-close" type="button" id="bots-settings-close" aria-label="Uždaryti">
            <svg class="ui-icon" aria-hidden="true"><use href="#icon-close"></use></svg>
        </button>
        <h3 id="bots-settings-title" class="bot-mode-title">
            <span class="bot-mode-monkey" aria-hidden="true">@await Html.PartialAsync("_Monkey", new MonkeyViewModel { HatColor = "#7E57C2" })</span>
            Botų nustatymai
        </h3>
        <p class="bot-dialog-lead">Prisitaikantis botas važiuoja tavo tempu, kiti – pastoviu greičiu: lengvas ~25, vidutinis ~45, sunkus ~75 WPM.</p>
        @for (var index = 0; index < botSettings.Length; index++)
        {
            var bot = botSettings[index];
            <div class="bot-setting">
                <span class="bot-setting-monkey" aria-hidden="true">@await Html.PartialAsync("_Monkey", new MonkeyViewModel { BodyColor = bot.Body, HatColor = bot.Hat })</span>
                <strong>@bot.Name</strong>
                <div class="tm-group" role="group" aria-label="@bot.Name charakteris">
                    @foreach (var level in botLevels)
                    {
                        <button class="tm" type="button" data-bot-index="@index" data-bot-level="@level.Value"
                                aria-pressed="@(level.Value == "adaptive" ? "true" : "false")">@level.Label</button>
                    }
                </div>
            </div>
        }
        <a class="btn btn-p" id="bots-settings-play" href="/race/bots?levels=adaptive,adaptive,adaptive">
            <svg class="ui-icon" aria-hidden="true"><use href="#icon-play"></use></svg>Žaisti su šiais botais
        </a>
    </dialog>

    <section class="card leaderboard" aria-labelledby="top10-title">
        <div class="leaderboard-head">
            <h2 id="top10-title"><svg class="ui-icon" aria-hidden="true"><use href="#icon-trophy"></use></svg>Top 10 rezultatų</h2>
            <span class="pill">Online · visą laiką</span>
        </div>
        <div class="lb-row lb-top10 lb-header" aria-hidden="true">
            <span>#</span><span>Žaidėjas</span><span>WPM</span><span>Tikslumas</span><span>Vieta</span>
            <span class="lb-id">Tekstas</span><span class="lb-id">Rezultatas</span><span class="lb-date">Data</span>
        </div>
        @* id naudoja navbar nuoroda „Lyderiai" ir loadTop10() *@
        <div id="top10-body" class="lb-body" role="list">
            <p class="lb-empty">Kraunama...</p>
        </div>
    </section>
</div>

<script>
    const CURRENT_USER = @Json.Serialize(currentUser);

    function escapeHtml(value) {
        return String(value).replace(/[&<>"']/g, char =>
            ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]);
    }

    async function loadTop10() {
        const body = document.getElementById('top10-body');
        try {
            const res = await fetch('/api/stats/top10/');
            const data = await res.json();
            body.innerHTML = data.length ? data.map((user, index) => `
                <div class="lb-row lb-top10 ${user.username === CURRENT_USER ? "is-me" : ""}" role="listitem">
                    <span class="lb-place ${index < 3 ? "lb-place-" + (index + 1) : ""}">${index + 1}</span>
                    <span class="lb-name">${escapeHtml(user.username)}</span>
                    <span class="lb-num"><strong>${user.wpm}</strong></span>
                    <span class="lb-num">${user.accuracy}%</span>
                    <span class="lb-num">${user.place ?? "–"}</span>
                    <span class="lb-num lb-id">${user.textId != null ? "#" + user.textId : "–"}</span>
                    <span class="lb-num lb-id">#${user.resultId}</span>
                    <span class="lb-date">${user.date}</span>
                </div>`).join("")
                : `<p class="lb-empty">Dar nėra rezultatų. Būk pirmas!</p>`;
        } catch (err) {
            body.innerHTML = `<p class="lb-empty">Nepavyko įkelti lyderių.</p>`;
            console.error("Failed to load top10", err);
        }
    }
    loadTop10();

    // Žodžių režimo trukmės pasirinkimas keičia Solo ir Online nuorodas
    document.querySelectorAll("[data-words-seconds]").forEach(button =>
        button.addEventListener("click", () => {
            document.querySelectorAll("[data-words-seconds]").forEach(other =>
                other.setAttribute("aria-pressed", String(other === button)));
            document.getElementById("words-solo").href =
                `/race/words?seconds=${button.dataset.wordsSeconds}`;
            document.getElementById("words-online").href =
                `/race/quick?seconds=${button.dataset.wordsSeconds}`;
        }));

    // Botų charakteriai: pasirinkimas prisimenamas naršyklėje ir keliauja į /race/bots?levels=
    const botDialog = document.getElementById("bots-settings");
    let botLevels = JSON.parse(localStorage.getItem("monkeyrace-bot-levels") || "null") ||
        ["adaptive", "adaptive", "adaptive"];
    function applyBotLevels() {
        document.querySelectorAll("[data-bot-level]").forEach(button =>
            button.setAttribute("aria-pressed",
                String(botLevels[button.dataset.botIndex] === button.dataset.botLevel)));
        const href = `/race/bots?levels=${botLevels.join(",")}`;
        document.getElementById("bots-play").href = href;
        document.getElementById("bots-settings-play").href = href;
    }
    document.querySelectorAll("[data-bot-level]").forEach(button =>
        button.addEventListener("click", () => {
            botLevels[button.dataset.botIndex] = button.dataset.botLevel;
            localStorage.setItem("monkeyrace-bot-levels", JSON.stringify(botLevels));
            applyBotLevels();
        }));
    document.getElementById("bots-settings-open").addEventListener("click", () => botDialog.showModal());
    document.getElementById("bots-settings-close").addEventListener("click", () => botDialog.close());
    // paspaudus už lango ribų (ant ::backdrop) – uždaryti; target tas pats ir paspaudus ant paties lango paraštės
    botDialog.addEventListener("click", event => {
        const box = botDialog.getBoundingClientRect();
        if (event.target === botDialog && (event.clientX < box.left || event.clientX > box.right ||
            event.clientY < box.top || event.clientY > box.bottom)) botDialog.close();
    });
    applyBotLevels();

    // kodas privalomas tik prisijungiant; kuriant kambarį tikrinamas tik vardas
    const roomCodeInput = document.getElementById("room-code-input");
    document.getElementById("room-create").addEventListener("click", () => roomCodeInput.required = false);
    document.getElementById("room-join").addEventListener("click", () => roomCodeInput.required = true);
</script>
