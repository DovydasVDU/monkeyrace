@model TextSnippet
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Rašyk - Monkeyrace";
    // null = klasikinė solo treniruotė, kitaip žodžių režimo trukmė sekundėmis
    int? duration = ViewBag.Duration;
    var durationLabel = duration < 60 ? $"{duration} s" : $"{duration / 60} min";
    // /race/train: tekstas iš žaidėjo klaidų, rezultatas nesaugomas
    bool training = ViewBag.Training == true;
    var modeLabel = training ? "Treniruoklis" : duration == null ? "Solo treniruotė" : "Dažniausi žodžiai";
}


<div class="race-page">
    <section class="race-screen">
        <div class="race-topbar">
            <a class="btn btn-g race-leave" href="/">
                <svg class="ui-icon" aria-hidden="true"><use href="#icon-arrow-left"></use></svg>
                <span>Išeiti</span>
            </a>
            <div class="race-title-wrap">
                <p class="eyebrow">@modeLabel</p>
                <h1>@(training ? "Rašyk savo klaidų žodžius" : duration == null ? "Rašyk savo tempu" : $"Rašyk {durationLabel}")</h1>
            </div>
            <div class="race-stats" id="stats-bar" aria-label="Statistika">
                <span class="stat-pill"><small>WPM</small><strong id="wpm-display">0</strong></span>
                <span class="stat-pill"><small>Tikslumas</small><strong><span id="accuracy-display">100</span>%</strong></span>
                <span class="stat-pill"><small>@(duration == null ? "Laikas" : "Liko")</small><strong><span id="timer-display">@(duration ?? 0)</span> s</strong></span>
            </div>
        </div>

        <div class="card text-card">
            <div id="text-display" class="text-display"></div>
            <input type="text" id="input-field" class="word-input" aria-label="Rašymo laukas"
                   autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
                   placeholder="Pradėk spausdinti..." autofocus />
        </div>
        <p class="race-hint">@(duration == null ? "" : "Laikas pradeda bėgti nuo pirmo klavišo. ")Žodis su klaida neleidžia pereiti toliau. Ištaisyk jį, kad tęstum.</p>
    </section>
</div>
<div class="results-overlay" id="results-overlay">
    <section class="card results-box personal-result" role="dialog" aria-modal="true" aria-labelledby="solo-result-title">
        <div class="result-head">
            <span class="place-badge" aria-hidden="true"><svg class="ui-icon" aria-hidden="true"><use href="#icon-flag"></use></svg></span>
            <div>
                <p class="eyebrow">@(duration == null ? modeLabel : $"{modeLabel} · {durationLabel}")</p>
                <h2 id="solo-result-title">@(duration == null ? "Tekstas baigtas!" : "Laikas baigėsi!")</h2>
            </div>
        </div>
        <div class="personal-result-grid">
            <div class="result-metric"><span>WPM</span><strong id="result-wpm">0</strong></div>
            <div class="result-metric"><span>Tikslumas</span><strong><span id="result-accuracy">0</span>%</strong></div>
            <div class="result-metric"><span>Laikas</span><strong><span id="result-time">0</span> s</strong></div>
            <div class="result-metric result-metric-errors"><span>Klaidos</span><strong id="result-klaidos">0</strong></div>
        </div>

        <div id="solo-reward" aria-live="polite" hidden></div>

        <div class="result-actions">
            <button class="btn btn-p" type="button" onclick="restartRace()">
                <svg class="ui-icon" aria-hidden="true"><use href="#icon-play"></use></svg>Žaisti dar kartą
            </button>
            <button class="btn btn-s" type="button" onclick="retrySameText()">
                <svg class="ui-icon" aria-hidden="true"><use href="#icon-redo"></use></svg>Kartoti tekstą
            </button>
            <a class="btn btn-s" href="/">
                <svg class="ui-icon" aria-hidden="true"><use href="#icon-home"></use></svg>Į pradžią
            </a>
        </div>

        @* žodžių režimo tekstas sugeneruotas, todėl jo kilmės nėra *@
        @if (Model.SourceId != null)
        {
            <details class="result-details text-about" id="text-about">
                <summary>Apie tekstą</summary>
                <div class="details-content">
                    <dl>
                        <div><dt>Autorius</dt><dd>@Model.Author</dd></div>
                        <div><dt>Kūrinys</dt><dd>@Model.Work</dd></div>
                        <div><dt>Šaltinis</dt><dd><a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer">@Uri.UnescapeDataString(Model.SourceUrl)</a></dd></div>
                        <div><dt>Licencija</dt><dd>@Model.LicenseLabel</dd></div>
                        @if (Model.FlagLabels.Length > 0)
                        {
                            <div><dt>Ypatybės</dt><dd>@string.Join(", ", Model.FlagLabels)</dd></div>
                        }
                    </dl>
                </div>
            </details>
        }
    </section>
</div>

    <script src="~/js/typing.js" asp-append-version="true"></script>
    <script>
         
        let TARGET_TEXT = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Content));
        // 0 = klasikinis režimas (iki teksto pabaigos), kitaip rašoma tiek sekundžių
        const DURATION_SECONDS = @(duration ?? 0);
        const TRAINING = @training.ToString().ToLowerInvariant();

        const klaidosSet = new Set();
        let targetWords = [];
        let currentWordIndex = 0;
        let totalTypedChars = 0;
        let totalKeystrokes = 0;
        let wrongKeystrokes = 0;
        let mistakes = createMistakeTracker();
        let currentWordHadError = false;

        let startTime   = null;
        let timerHandle = null;
        let isFinished  = false;

        const inputField      = document.getElementById('input-field');
        const wpmDisplay      = document.getElementById('wpm-display');
        const accuracyDisplay = document.getElementById('accuracy-display');
        const timerDisplay    = document.getElementById('timer-display');

        function renderText() {
            targetWords = TARGET_TEXT.split(' ');
            const container = document.getElementById('text-display');
            container.innerHTML = '';
            container.classList.toggle('is-words', DURATION_SECONDS > 0);
            container.scrollTop = 0;

            targetWords.forEach((word, index) => {
                const wordSpan = document.createElement('span');
                wordSpan.className = 'word' + (index === 0 ? ' active' : '');
                wordSpan.id = 'word-elem-' + index;

                for (let i = 0; i < word.length; i++) {
                    const charSpan = document.createElement('span');
                    charSpan.className = 'char';
                    charSpan.textContent = word[i];
                    wordSpan.appendChild(charSpan);
                }
                container.appendChild(wordSpan);
            });

            container.style.display = 'block';
        }

        function init() {
            renderText();
            inputField.focus();

            inputField.addEventListener('input', function(e) {
                if (isFinished) return;

                if (startTime === null) {
                    startTime = Date.now();
                    timerHandle = setInterval(updateTimer, 200);
                }

                let typed = this.value;
                const targetWord = targetWords[currentWordIndex];
                if (!targetWord) return;
                const isLastWord = currentWordIndex === targetWords.length - 1;
                if (typed.endsWith(' ')) {
                    const typedWord = typed.slice(0, -1);
                    if (typedWord !== targetWord) {
                        this.value = typedWord;
                        updateCurrentWord(typedWord, targetWord);
                        flashWordError();
                        return;
                    }
                    if (isLastWord) {
                        this.value = typedWord;
                        typed = typedWord;
                    }
                }
                if (e.inputType === 'insertText' && e.data) {
                    const previousLength = Math.max(0, typed.length - e.data.length);
                    const targetOffset = targetWords
                        .slice(0, currentWordIndex)
                        .reduce((total, word) => total + word.length + 1, 0);
                    for (let index = 0; index < e.data.length; index++) {
                        const targetIndex = targetOffset + previousLength + index;
                        if (previousLength + index >= targetWord.length + 8)
                            continue;
                        totalKeystrokes++;
                        // už žodžio ribų (extra) laukiamos raidės nėra – į raidžių statistiką neskaičiuojam
                        if (previousLength + index <= targetWord.length)
                            mistakes.key(TARGET_TEXT[targetIndex], e.data[index]);
                        if (e.data[index] !== TARGET_TEXT[targetIndex]) {
                            wrongKeystrokes++;
                            currentWordHadError = true;
                        }
                    }
                }
                if (typed.endsWith(' ') && !isLastWord) {
                    const typedWord = typed.slice(0, -1);
                    if (typedWord === targetWord) {
                        const chars = document.getElementById('word-elem-' + currentWordIndex).querySelectorAll('.char');
                        chars.forEach(c => c.classList.add('correct'));
                        document.getElementById('word-elem-' + currentWordIndex).classList.remove('active');

                        totalTypedChars += targetWord.length + 1;
                        mistakes.word(targetWord, currentWordHadError);
                        currentWordHadError = false;
                        currentWordIndex++;

                        document.getElementById('word-elem-' + currentWordIndex).classList.add('active');
                        scrollToActiveWord();
                        this.value = '';
                        this.classList.remove('error');

                        wpmDisplay.textContent = calcWPM(totalTypedChars);
                        return;
                    }
                }

                typed = this.value;

                if (isLastWord && typed === targetWord) {
                    const chars = document.getElementById('word-elem-' + currentWordIndex).querySelectorAll('.char');
                    chars.forEach(c => c.classList.add('correct'));
                    totalTypedChars += targetWord.length;
                    wpmDisplay.textContent = calcWPM(totalTypedChars);
                    mistakes.word(targetWord, currentWordHadError);
                    currentWordHadError = false;
                    finishRace();
                    return;
                }

                updateCurrentWord(typed, targetWord);

                if (startTime !== null) {
                    wpmDisplay.textContent = calcWPM(totalTypedChars + typed.length);
                    accuracyDisplay.textContent = calcAccuracy().toFixed(1);
                }
            });

            document.addEventListener('click', () => { if (!isFinished) inputField.focus(); });
        }

        function updateCurrentWord(typed, targetWord) {
            const wordElem = document.getElementById('word-elem-' + currentWordIndex);
            let isError = false;
            const rendered = renderWord(targetWord, typed);
            wordElem.querySelectorAll('.char').forEach((element, index) => {
                const state = rendered[index];
                element.className = `char ${state.state === 'wrong' ? 'char-wrong' :
                    state.state === 'correct' ? 'correct' : ''}`;
                element.textContent = state.state === 'wrong'
                    ? state.ch : state.expected;
                if (state.state === 'wrong') {
                    const expected = document.createElement('span');
                    expected.className = 'char-expected';
                    expected.textContent = state.expected;
                    element.appendChild(expected);
                    isError = true;
                    klaidosSet.add(`${currentWordIndex}-${index}`);
                }
            });
            wordElem.querySelectorAll('.char-extra').forEach(element => element.remove());
            rendered.filter(item => item.state === 'extra').forEach(item => {
                const extra = document.createElement('span');
                extra.className = 'char-extra';
                extra.textContent = item.ch;
                wordElem.appendChild(extra);
                isError = true;
            });
            wordElem.querySelectorAll('.char').forEach((element, index) => {
                element.classList.remove('current');
                if (index === typed.length && index < targetWord.length)
                    element.classList.add('current');
            });

            // klaida rašomame žodyje: visas žodis ir input švelniai raudoni, kol ištaisoma
            const hasError = typed.length > targetWord.length || isError;
            inputField.classList.toggle('error', hasError);
            wordElem.classList.toggle('word-error', hasError);
        }

        function flashWordError() {
            const word = document.getElementById('word-elem-' + currentWordIndex);
            word.classList.remove('word-input-error');
            void word.offsetWidth;
            word.classList.add('word-input-error');
            setTimeout(() => word.classList.remove('word-input-error'), 180);
        }

        // Žodžių režime matomos 3 eilutės: aktyvi eilutė laikoma antra, kad matytųsi ir kita
        function scrollToActiveWord() {
            if (!DURATION_SECONDS) return;
            const active = document.getElementById('word-elem-' + currentWordIndex);
            document.getElementById('text-display').scrollTop =
                Math.max(0, active.offsetTop - active.offsetHeight);
        }

        function calcWPM(charsTyped) {
            if (!startTime || charsTyped === 0) return 0;
            let elapsedMs = Date.now() - startTime;
            // laikmatis tikrina kas 200 ms, todėl vėlavimas neturi mažinti WPM
            if (DURATION_SECONDS) elapsedMs = Math.min(elapsedMs, DURATION_SECONDS * 1000);
            return typingWpm(charsTyped, elapsedMs);
        }

        function calcAccuracy() {
            return typingAccuracy(totalKeystrokes, wrongKeystrokes);
        }

        function updateTimer() {
            if (!startTime) return;
            const elapsedSeconds = Math.floor((Date.now() - startTime) / 1000);
            if (DURATION_SECONDS) {
                timerDisplay.textContent = Math.max(0, DURATION_SECONDS - elapsedSeconds);
                if (Date.now() - startTime >= DURATION_SECONDS * 1000 && !isFinished) {
                    finishRace();
                    return;
                }
            } else {
                timerDisplay.textContent = elapsedSeconds;
            }
            if (!isFinished) {
                accuracyDisplay.textContent = calcAccuracy().toFixed(1);
            }
        }

        function finishRace() {
            isFinished = true;
            clearInterval(timerHandle);
            inputField.disabled = true;

            const timeSeconds = DURATION_SECONDS || Math.round((Date.now() - startTime) / 1000);
            const wpm         = calcWPM(totalTypedChars);
            const accuracy    = calcAccuracy();
            const klaidos     = wrongKeystrokes;

            document.getElementById('result-wpm').textContent      = wpm;
            document.getElementById('result-accuracy').textContent = accuracy.toFixed(1);
            document.getElementById('result-time').textContent     = timeSeconds;
            document.getElementById('result-klaidos').textContent  = klaidos;
            document.getElementById('results-overlay').classList.add('visible');

            // žodžių režime laikas baigiasi žodžio viduryje: jį skaičiuojam tik jei jame jau suklysta
            if (currentWordHadError)
                mistakes.word(targetWords[currentWordIndex], true);
            mistakes.send();

            if (TRAINING) {
                const reward = document.getElementById('solo-reward');
                reward.hidden = false;
                reward.classList.add('reward-panel');
                reward.innerHTML = '<p class="reward-muted">Treniruotė XP neduoda. Žodis dingsta iš sąrašo, kai jį parašai be klaidų 3 kartus iš eilės.</p>';
                return;
            }

            fetch('/Race/SaveResult', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    wpm:         wpm,
                    accuracy:    accuracy,
                    timeSeconds: timeSeconds,
                    errorCount:  klaidos
                })
            })
                .then(res => res.ok ? res.json() : null)
                .then(data => renderReward(document.getElementById('solo-reward'), data && data.reward))
                .catch(() => renderReward(document.getElementById('solo-reward'), null));
        }

        function retrySameText(){
            document.getElementById('results-overlay').classList.remove('visible');
            document.getElementById('solo-reward').hidden = true;

            // Atstatome kintamuosius
            klaidosSet.clear();
            currentWordIndex = 0;
            totalTypedChars = 0;
            totalKeystrokes = 0;
            wrongKeystrokes = 0;
            mistakes = createMistakeTracker();
            currentWordHadError = false;
            startTime = null;
            timerHandle = null;
            isFinished = false;

            wpmDisplay.textContent = '0';
            accuracyDisplay.textContent = '100';
            timerDisplay.textContent = DURATION_SECONDS;

            inputField.value = '';
            inputField.disabled = false;
            inputField.classList.remove('error');

            renderText();
            inputField.focus();
        }

        function restartRace() {
            window.location.href = TRAINING ? '/race/train'
                : DURATION_SECONDS ? `/race/words?seconds=${DURATION_SECONDS}` : `/Race/Play`;
        }

        init();

       
    </script>
