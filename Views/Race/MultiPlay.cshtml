@using System.Text.Json
@{
    ViewData["Title"] = "Lenktynės - MonkeyRace";
    var raceId = (string)ViewBag.RaceId;
    var playerKey = (string)ViewBag.PlayerKey;
    var username = (string)ViewBag.Username;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="match-page">
    @* Būsena be JS klasių: kol #text-display tuščias – laukimas (race.css :has()) *@
    <section class="race-screen" id="race-panel">
        <div class="race-topbar">
            <button class="btn btn-g race-leave" id="leave-button" type="button" onclick="leaveRace()">
                <svg class="ui-icon" aria-hidden="true"><use href="#icon-arrow-left"></use></svg>
                <span>Išeiti</span>
            </button>
            <div class="race-title-wrap">
                <p class="eyebrow">Žaisti internetu</p>
                <h1 id="race-title">Laukiame varžovų</h1>
            </div>
            <div class="race-stats" aria-label="Lenktynių statistika">
                <span class="stat-pill"><small>WPM</small><strong id="wpm-display">0</strong></span>
                <span class="stat-pill"><small>Tikslumas</small><strong><span id="accuracy-display">100</span>%</strong></span>
                <span class="stat-pill"><small>Laikas</small><strong><span id="timer-display">0</span> s</strong></span>
            </div>
        </div>

        <div class="lobby-ring" aria-hidden="true">
            <strong id="lobby-seconds">–</strong>
            <span>Ieškome varžovų</span>
        </div>
        <div class="xp-track is-banana lobby-bar" aria-hidden="true"><span id="lobby-bar-fill" style="width:0%"></span></div>

        <div class="queue-status" id="queue-status" aria-live="polite">Jungiama prie lenktynių...</div>
        <div class="queue-meta" id="queue-meta"></div>
        <div class="countdown" id="countdown" aria-live="polite" hidden></div>

        <div class="card tracks-card">
            <div class="players-track" id="players-track"></div>
            <div class="lobby-slots" aria-hidden="true">
                <div class="slot"><span class="slot-avatar"></span>Laukiama žaidėjo</div>
                <div class="slot"><span class="slot-avatar"></span>Laukiama žaidėjo</div>
                <div class="slot"><span class="slot-avatar"></span>Laukiama žaidėjo</div>
            </div>
            <div class="race-lane-label"><span>Startas</span><span>Finišas</span></div>
        </div>
        <p class="lobby-note">Tuščios vietos bus užpildytos botais. Botų rezultatai neįskaitomi.</p>

        <div class="card text-card">
            <div class="text-display" id="text-display"></div>
            <input type="text" id="input-field" class="word-input" aria-label="Rašymo laukas"
                   autocomplete="off" autocorrect="off" autocapitalize="off"
                   spellcheck="false" placeholder="Laukite starto..." disabled />
        </div>
        <p class="race-hint">Žodis su klaida neleidžia pereiti toliau. Ištaisyk jį, kad tęstum.</p>

        <div class="race-result" id="race-result" hidden>
            <div class="personal-result" id="personal-result" hidden>
                <p class="eyebrow">Tavo rezultatas</p>
                <h2 id="personal-result-title">Finišavai!</h2>
                <div class="personal-result-grid">
                    <div class="result-metric result-metric-place">
                        <span>Vieta</span><strong id="personal-place">—</strong>
                    </div>
                    <div class="result-metric result-metric-wpm">
                        <span>WPM</span><strong id="personal-wpm">—</strong>
                    </div>
                    <div class="result-metric">
                        <span>Tikslumas</span><strong id="personal-accuracy">—</strong>
                    </div>
                    <div class="result-metric">
                        <span>Laikas</span><strong id="personal-time">—</strong>
                    </div>
                    <div class="result-metric result-metric-errors">
                        <span>Klaidos</span><strong id="personal-errors">—</strong>
                    </div>
                </div>
                <div class="reward-placeholder" id="personal-reward">
                    Bananai ir XP – netrukus
                </div>
            </div>
            <div class="podium" id="podium"></div>
            <div class="final-results" id="final-results" hidden>
                <p class="eyebrow">Rezultatai</p>
                <div id="final-results-list"></div>
                <p class="bot-explanation" id="bot-explanation" hidden>
                    Botas: kompiuterio valdomas žaidėjas
                </p>
            </div>
            <div class="result-actions">
                <a class="monkey-button" href="/race/quick">
                    Žaisti dar kartą
                </a>
                <a class="text-button" href="/">Į pradžią</a>
            </div>
            <section class="race-history" id="result-race-history">
                <h2>Lenktynių istorija</h2>
                <p id="result-history-status">Laukiama kitų žaidėjų…</p>
                <div class="leader-bar" id="result-leader-bar"></div>
                <div class="overtakes-list" id="result-overtakes-list"></div>
                <p id="result-leader-summary"></p>
            </section>
            <section class="race-replay" id="replay-race">
                <h2>Žiūrėti lenktynes</h2>
                <div class="replay-track" id="replay-track"></div>
                <div class="replay-controls">
                    <button type="button" id="replay-play" class="replay-main-button"
                            aria-label="Paleisti lenktynių replay" aria-pressed="false">
                        <svg class="control-icon icon-play" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M8 5v14l11-7z"/>
                        </svg><span>Paleisti</span>
                    </button>
                    <button type="button" id="replay-pause" class="replay-pause-button"
                            aria-label="Pristabdyti lenktynių replay">
                        <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M7 5h4v14H7zm6 0h4v14h-4z"/>
                        </svg><span>Pauzė</span>
                    </button>
                    <button type="button" id="replay-reset" class="replay-reset-button"
                            aria-label="Paleisti replay iš naujo">
                        <svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 5v6h6M5.5 11A7 7 0 1 0 7 6.1"/>
                        </svg><span>Iš naujo</span>
                    </button>
                    <div class="replay-speed" role="group" aria-label="Replay greitis">
                        <button type="button" data-replay-speed="1" aria-pressed="true">1x</button>
                        <button type="button" data-replay-speed="2" aria-pressed="false">2x</button>
                        <button type="button" data-replay-speed="4" aria-pressed="false">4x</button>
                    </div>
                    <div class="replay-scrubber">
                        <output id="replay-time">0,0 s / 0,0 s</output>
                        <input type="range" id="replay-range" min="0" max="0" value="0"
                               aria-label="Replay laiko pozicija">
                    </div>
                </div>
                <div id="replay-monkey-templates" hidden>
                    @await Html.PartialAsync("_Monkey", new MonkeyViewModel { Mood = "run", BodyColor = "#8D5A2B", HatColor = "#FFC93C" })
                    @await Html.PartialAsync("_Monkey", new MonkeyViewModel { Mood = "run", BodyColor = "#5D4037", HatColor = "#E53935" })
                    @await Html.PartialAsync("_Monkey", new MonkeyViewModel { Mood = "run", BodyColor = "#8B5E3C", HatColor = "#2E8B4F" })
                    @await Html.PartialAsync("_Monkey", new MonkeyViewModel { Mood = "run", BodyColor = "#795548", HatColor = "#7E57C2" })
                </div>
            </section>
            <section class="speed-chart" id="result-speed-chart">
                <h2>Mano greitis</h2>
                <svg id="result-wpm-chart" viewBox="0 0 640 180" role="img"
                     aria-label="WPM grafikas"></svg>
                <p>Vidurkis: <strong id="result-wpm-average">—</strong> ·
                    Aukščiausias: <strong id="result-wpm-high">—</strong></p>
            </section>
            <details class="word-errors" id="result-word-errors" open>
                <summary>Klaidos</summary>
                <div class="details-content">
                    <div id="result-error-words"></div>
                    <div class="word-error-legend" aria-label="Klaidų legenda">
                        <span class="legend-fixed">Pataisyta klaida</span>
                        <span class="legend-wrong">Liko neteisingai</span>
                    </div>
                    <p>Žodžiai su klaidomis:</p>
                    <ul id="result-error-list"></ul>
                </div>
            </details>
            <details class="text-about" id="text-about">
                <summary>Apie tekstą</summary>
                <div class="details-content">
                <dl>
                    <div id="text-length-row"><dt>Ilgis</dt><dd id="text-length"></dd></div>
                    <div id="text-word-count-row"><dt>Žodžiai</dt><dd id="text-word-count"></dd></div>
                    <div id="text-author-row" hidden><dt>Autorius</dt><dd id="text-author"></dd></div>
                    <div id="text-work-row" hidden><dt>Kūrinys</dt><dd id="text-work"></dd></div>
                    <div id="text-source-row" hidden><dt>Šaltinis</dt><dd><a id="text-source" target="_blank" rel="noopener noreferrer"></a></dd></div>
                </dl>
                </div>
            </details>
            <details class="race-statistics">
                <summary id="statistics-title">Lenktynių statistika</summary>
                <div class="details-content">
                    <div class="statistics-chart" id="statistics-chart">
                        <span>Netrukus</span>
                    </div>
                </div>
            </details>
        </div>
    </section>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
<script>
const RACE_ID = @Html.Raw(JsonSerializer.Serialize(raceId));
const PLAYER_KEY = @Html.Raw(JsonSerializer.Serialize(playerKey));
const USERNAME = @Html.Raw(JsonSerializer.Serialize(username));
const ATTEMPT = @((int)(ViewBag.Attempt ?? 0));
const IS_AUTHENTICATED = @isAuthenticated.ToString().ToLowerInvariant();
const TAB_ID = sessionStorage.getItem("monkeyrace-tab-id") ||
    (crypto.randomUUID ? crypto.randomUUID() :
        `${Date.now()}-${Math.random().toString(16).slice(2)}`);
sessionStorage.setItem("monkeyrace-tab-id", TAB_ID);
const connection = new signalR.HubConnectionBuilder()
    .withUrl("/racehub")
    .withAutomaticReconnect()
    .build();

let targetText = "";
let startAtUtc = null;
let serverOffsetMs = 0;
let raceStarted = false;
let finished = false;
let countdownTimer = null;
let raceTimer = null;
let inputTimer = null;
let totalKeystrokes = 0;
let wrongKeystrokes = 0;
let wordErrorStates = [];
let wordHadError = [];
let raceTimeline = null;
let raceAnalysis = null;
let raceTextLength = 0;
let replayTimer = null;
let replaySpeed = 1;
let replayIndex = 0;
const players = {};
const BOT_MONKEY_COLORS = ["#8D5A2B", "#5D4037", "#6D4C41", "#795548"];

const input = document.getElementById("input-field");
const queueStatus = document.getElementById("queue-status");
const queueMeta = document.getElementById("queue-meta");
const countdown = document.getElementById("countdown");

function serverNow() {
    return Date.now() + serverOffsetMs;
}

function setStatus(status, meta) {
    queueStatus.textContent = status;
    queueMeta.textContent = meta || "";
}

function isBotPlayer(player) {
    return Boolean(player && (player.isBot ||
        (player.id && player.id.startsWith("bot:")) ||
        (player.playerKey && player.playerKey.startsWith("bot:"))));
}

function getBotColorIndex(player, fallbackIndex) {
    const value = Number.isInteger(player?.colorIndex)
        ? player.colorIndex
        : Number.isInteger(players[player?.id]?.colorIndex)
            ? players[player.id].colorIndex
            : fallbackIndex;
    return Math.abs(value || 0) % BOT_MONKEY_COLORS.length;
}

function botBadge(player) {
    return isBotPlayer(player)
        ? `<span class="bot-badge" title="Botas: kompiuterio valdomas žaidėjas"
             aria-label="Botas">Botas</span>`
        : "";
}

// level (nebūtinas) rodomas kaip ženkliukas, toks pat kaip _Monkey.cshtml
function monkeyTemplate(colorIndex, level) {
    const templates = document.querySelectorAll(
        "#replay-monkey-templates .monkey-svg");
    const template = templates[Math.abs(colorIndex || 0) % templates.length];
    if (!template) return "";
    if (level == null) return template.outerHTML;
    const svg = template.cloneNode(true);
    svg.insertAdjacentHTML("beforeend",
        `<g class="monkey-level"><circle cx="134" cy="134" r="24"/>` +
        `<text x="134" y="144" text-anchor="middle">${Number(level)}</text></g>`);
    return svg.outerHTML;
}

function applyState(state) {
    targetText = state.text || targetText;
    state.players.forEach(player => players[player.playerKey] = player);
    renderPlayers();

    if (state.status === "Lobby") {
        setStatus("Laukiame varžovų...", `${state.players.length}/4 žaidėjai`);
        document.getElementById("race-title").textContent = "Laukiame varžovų";
        startLobbyClock(state.lobbyDeadlineUtc, state.serverNowUtc);
    } else if (state.status === "Countdown") {
        prepareCountdown(state.startAtUtc, state.serverNowUtc, targetText);
    } else if (state.status === "Racing") {
        prepareRace(state.startAtUtc, state.serverNowUtc, targetText);
    }
}

function startLobbyClock(deadline, serverNowUtc) {
    clearInterval(countdownTimer);
    const deadlineMs = Date.parse(deadline);
    serverOffsetMs = Date.parse(serverNowUtc) - Date.now();
    const lobbyTotalMs = Math.max(1, deadlineMs - serverNow());
    countdownTimer = setInterval(() => {
        const remaining = Math.max(0, Math.ceil((deadlineMs - serverNow()) / 1000));
        queueMeta.textContent = `${Object.keys(players).length}/4 žaidėjai · startas po ${remaining} s`;
        document.getElementById("lobby-seconds").textContent = remaining;
        document.getElementById("lobby-bar-fill").style.width =
            `${Math.min(100, 100 - (deadlineMs - serverNow()) * 100 / lobbyTotalMs)}%`;
        if (remaining === 0) clearInterval(countdownTimer);
    }, 100);
}

function prepareCountdown(startAt, serverNowUtc, text) {
    clearInterval(countdownTimer);
    targetText = text || targetText;
    startAtUtc = Date.parse(startAt);
    serverOffsetMs = Date.parse(serverNowUtc) - Date.now();
    renderText();
    countdown.hidden = false;
    input.disabled = true;
    countdownTimer = setInterval(() => {
        const remaining = Math.ceil((startAtUtc - serverNow()) / 1000);
        countdown.textContent = remaining > 0 ? remaining : "GO!";
        if (remaining <= 0) {
            clearInterval(countdownTimer);
            setTimeout(() => countdown.hidden = true, 1000);
        }
    }, 50);
}

function prepareRace(startAt, serverNowUtc, text) {
    targetText = text || targetText;
    startAtUtc = Date.parse(startAt);
    serverOffsetMs = Date.parse(serverNowUtc) - Date.now();
    renderText();
    wordErrorStates = [];
    wordHadError = [];
    totalKeystrokes = 0;
    wrongKeystrokes = 0;
    raceStarted = true;
    finished = false;
    input.readOnly = false;
    input.disabled = false;
    input.placeholder = "Pradėk spausdinti...";
    document.getElementById("race-title").textContent = "Lenktynės vyksta!";
    setStatus("Rašyk kuo greičiau!", `${Object.keys(players).length} žaidėjai trasoje`);
    focusRaceInput();
    clearInterval(raceTimer);
    raceTimer = setInterval(updateTimer, 100);
}

function focusRaceInput() {
    if (!raceStarted || finished || input.disabled) return;
    input.focus({ preventScroll: true });
    input.select();
    window.requestAnimationFrame(() => {
        if (document.activeElement !== input && !input.disabled)
            input.focus({ preventScroll: true });
    });
}

function deleteCurrentWord() {
    const lastSpace = input.value.lastIndexOf(" ");
    input.value = lastSpace < 0 ? "" : input.value.slice(0, lastSpace + 1);
    input.dispatchEvent(new Event("input", { bubbles: true }));
}

function showPersonalResult(data) {
    finished = true;
    input.disabled = true;
    clearInterval(raceTimer);
    document.getElementById("wpm-display").textContent = data.wpm;
    document.getElementById("race-result").hidden = false;
    document.getElementById("personal-result").hidden = false;
    document.getElementById("personal-place").textContent = `#${data.place}`;
    document.getElementById("personal-wpm").textContent = data.wpm;
    document.getElementById("personal-accuracy").textContent =
        `${Number(data.accuracy).toFixed(1)}%`;
    document.getElementById("personal-time").textContent = `${data.timeSeconds} s`;
    document.getElementById("personal-errors").textContent = data.errorCount;
    // tikras apdovanojimas ateina su RaceFinished, kai visi žmonės baigia
    document.getElementById("personal-reward").textContent = IS_AUTHENTICATED
        ? "Skaičiuojami XP ir bananai..."
        : "Laukiama kitų žaidėjų...";
    finalizeWordErrors();
    renderWordErrors();
    renderTextAbout();
}

function renderTextAbout() {
    document.getElementById("text-length").textContent = targetText.length;
    document.getElementById("text-word-count").textContent =
        targetText.trim() ? targetText.trim().split(/\s+/).length : 0;
}

connection.on("RaceState", applyState);
connection.on("PlayerJoined", data => {
    players[data.player.playerKey] = data.player;
    renderPlayers();
    if (!raceStarted) setStatus("Varžovai renkasi...", `${Object.keys(players).length}/4 žaidėjai`);
});
connection.on("Countdown", data => prepareCountdown(
    data.startAtUtc, data.serverNowUtc, data.text));
connection.on("RaceStarted", data => prepareRace(
    data.startAtUtc, data.serverNowUtc, targetText));
input.addEventListener("click", focusRaceInput);
document.addEventListener("keydown", event => {
    if (!raceStarted || finished || event.metaKey)
        return;
    if ((event.ctrlKey || event.altKey) && event.key === "Backspace") {
        event.preventDefault();
        deleteCurrentWord();
        return;
    }
    if (event.ctrlKey || event.altKey)
        return;
    if (document.activeElement === input)
        return;

    if (event.key.length === 1 || event.key === "Backspace") {
        event.preventDefault();
        focusRaceInput();
        if (event.key === "Backspace")
            input.value = input.value.slice(0, -1);
        else
            input.value += event.key;
        input.dispatchEvent(new InputEvent("input", {
            bubbles: true,
            inputType: event.key === "Backspace" ? "deleteContentBackward" : "insertText",
            data: event.key === "Backspace" ? null : event.key
        }));
    }
});
input.addEventListener("paste", event => event.preventDefault());
connection.on("Progress", data => {
    const player = players[data.playerKey] || {};
    Object.assign(player, data);
    players[data.playerKey] = player;
    const track = document.getElementById(`track-${cssId(data.playerKey)}`);
    if (track) track.style.setProperty("--progress", `${data.progress}%`);
    const wpm = document.getElementById(`wpm-${cssId(data.playerKey)}`);
    if (wpm) wpm.textContent = `${data.wpm} WPM`;
});
connection.on("PlayerFinished", data => {
    const track = document.getElementById(`track-${cssId(data.playerKey)}`);
    if (track) {
        // paskutinis Progress gali būti dar ne 100 %
        track.style.setProperty("--progress", "100%");
        const name = track.querySelector(".player-name");
        if (name) name.innerHTML =
            `${escapeHtml(data.username)} · #${data.place} ${botBadge(data)}`;
    }
    if (data.playerKey === PLAYER_KEY) showPersonalResult(data);
});
connection.on("RaceFinished", data => {
    finished = true;
    input.disabled = true;
    clearInterval(raceTimer);
    document.getElementById("race-result").hidden = false;
    document.getElementById("race-title").textContent = "Lenktynės baigtos!";
    setStatus("Rezultatai žemiau", "");
    document.getElementById("final-results").hidden = false;
    const hasBots = data.players.some(player => player.isBot);
    document.getElementById("bot-explanation").hidden = !hasBots;
    const me = data.players.find(player => player.playerKey === PLAYER_KEY);
    if (me && me.reward)
        renderReward(document.getElementById("personal-reward"), me.reward);
    document.getElementById("final-results-list").innerHTML = data.players.map(player => `
        <div class="podium-item">
            <strong>${player.place ? "#" + player.place : "DNF"}</strong>
            <span class="result-player-name">${escapeHtml(player.username)}
                ${botBadge(player)}</span>
            <small>${player.wpm} WPM · ${Math.round(player.accuracy)}%${player.isDnf ? " · DNF" : ""}</small>
        </div>`).join("");
    raceTimeline = data.timeline;
    raceAnalysis = data.analysis;
    raceTextLength = data.textLength || targetText.length;
    renderRaceHistory();
    renderReplay();
    renderWpmChart();
    renderWordErrors();
});
function retryMatchmaking() {
    window.location.href = `/race/quick?attempt=${ATTEMPT + 1}`;
}

connection.on("RaceUnavailable", retryMatchmaking);
connection.onreconnected(() =>
    connection.invoke("JoinRace", RACE_ID, PLAYER_KEY, USERNAME, TAB_ID));

input.addEventListener("input", event => {
    if (!raceStarted || finished) return;
    let typed = input.value;
    const ranges = getTargetWordRanges();
    // ką tik įvestas tarpas priklauso dar ankstesniam žodžiui
    const activeIndex = getActiveWordIndex(typed.endsWith(" ") ? typed.slice(0, -1) : typed);
    const activeRange = ranges[Math.max(0, activeIndex)];
    if (activeRange && !typed.endsWith(" ")) {
        const wordStart = activeRange.start;
        const maxLength = activeRange.word.length + 8;
        const activeTyped = typed.slice(wordStart);
        if (activeTyped.length > maxLength) {
            input.value = typed.slice(0, wordStart + maxLength);
            typed = input.value;
        }
    }
    if (typed.endsWith(" ") && activeRange) {
        const typedWord = typed.slice(activeRange.start, -1);
        if (typedWord !== activeRange.word) {
            input.value = typed.slice(0, -1);
            updateCharacters(input.value);
            flashWordError(activeIndex);
            return;
        }
        if (activeIndex === ranges.length - 1) {
            input.value = typed.slice(0, -1);
            typed = input.value;
        }
    }
    if (event.inputType === "insertText" && event.data) {
        const insertionStart = Math.max(0, typed.length - event.data.length);
        for (let index = 0; index < event.data.length; index++) {
            const targetIndex = insertionStart + index;
            const range = getTargetWordRanges().find(item =>
                targetIndex >= item.start && targetIndex < item.end + 8);
            const isWhitespace = /\s/.test(targetText[targetIndex] || "");
            if ((!range && !isWhitespace) ||
                (range && targetIndex >= range.end + 8))
                continue;
            totalKeystrokes++;
            if (event.data[index] !== targetText[targetIndex])
                wrongKeystrokes++;
        }
    }
    const correctChars = getCorrectChars(typed);
    recordWordErrors(typed);
    updateCharacters(typed);
    connection.invoke("SendProgress", RACE_ID, PLAYER_KEY, correctChars,
        totalKeystrokes, wrongKeystrokes)
        .catch(console.error);
    document.getElementById("accuracy-display").textContent =
        totalKeystrokes === 0
            ? "100.0"
            : ((totalKeystrokes - wrongKeystrokes) * 100 /
                totalKeystrokes).toFixed(1);
    if (correctChars === targetText.length) {
        input.disabled = true;
        finished = true;
    }
});

function getCorrectChars(typed) {
    const ranges = getTargetWordRanges();
    let correctChars = 0;
    for (let index = 0; index < ranges.length; index++) {
        const range = ranges[index];
        const wordStart = range.start;
        const wordEnd = Math.min(typed.length, wordStart + range.word.length);
        let wordCorrect = 0;
        while (wordStart + wordCorrect < wordEnd &&
               typed[wordStart + wordCorrect] === range.word[wordCorrect]) {
            wordCorrect++;
        }
        correctChars += wordCorrect;
        if (wordCorrect < range.word.length)
            return correctChars;
        if (index < ranges.length - 1) {
            if (typed[wordStart + range.word.length] !== " ")
                return correctChars;
            correctChars++;
        }
    }
    return correctChars;
}

function recordWordErrors(typed) {
    const ranges = getTargetWordRanges();
    ranges.forEach((range, wordIndex) => {
        const typedWord = typed.slice(range.start, range.end);
        for (let index = 0; index < typedWord.length; index++) {
            if (typedWord[index] !== range.word[index])
                wordHadError[wordIndex] = true;
        }
        if (typed.length >= range.end) {
            wordErrorStates[wordIndex] = typedWord === range.word &&
                !wordHadError[wordIndex] ? 0 :
                typedWord === range.word ? 1 : 2;
        }
    });
}

function finalizeWordErrors() {
    getTargetWordRanges().forEach((range, index) => {
        const typedWord = input.value.slice(range.start, range.end);
        wordErrorStates[index] = typedWord === range.word
            ? (wordHadError[index] ? 1 : 0)
            : 2;
    });
}

function getTargetWordRanges() {
    const ranges = [];
    const expression = /\S+/g;
    let match;
    while ((match = expression.exec(targetText)) !== null) {
        ranges.push({
            word: match[0],
            start: match.index,
            end: match.index + match[0].length
        });
    }
    return ranges;
}

function updateTimer() {
    if (!raceStarted || !startAtUtc) return;
    const elapsedMs = Math.max(0, serverNow() - startAtUtc);
    document.getElementById("timer-display").textContent = Math.floor(elapsedMs / 1000);
    // ta pati formulė kaip serveryje (MatchmakingService): teisingi simboliai / 5 per minutę
    document.getElementById("wpm-display").textContent = elapsedMs < 1000 ? 0 :
        Math.round(getCorrectChars(input.value) / 5 / (elapsedMs / 60000));
}

function updateCharacters(typed) {
    const ranges = getTargetWordRanges();
    const activeIndex = getActiveWordIndex(typed);
    if (activeIndex < 0) return;
    const range = ranges[activeIndex];
    const typedWord = typed.slice(range.start, Math.max(range.start, typed.length));
    const wordElement = document.querySelector(
        `#text-display .word[data-word-index="${activeIndex}"]`);
    if (!wordElement) return;
    const rendered = renderWord(range.word, typedWord);
    wordElement.querySelectorAll(".char").forEach((element, index) => {
        const state = rendered[index];
        element.className = `char ${state.state === "wrong" ? "char-wrong" :
            state.state === "correct" ? "correct" : ""}`;
        element.textContent = state.state === "wrong" ? state.ch : state.expected;
        if (state.state === "wrong") {
            const expected = document.createElement("span");
            expected.className = "char-expected";
            expected.textContent = state.expected;
            element.appendChild(expected);
        }
        if (index === typedWord.length && index < range.word.length)
            element.classList.add("current");
    });
    wordElement.querySelectorAll(".char-extra").forEach(element => element.remove());
    rendered.filter(item => item.state === "extra").forEach(item => {
        const extra = document.createElement("span");
        extra.className = "char-extra";
        extra.textContent = item.ch;
        wordElement.appendChild(extra);
    });
}

function getActiveWordIndex(typed) {
    const completedWords = (typed.match(/ /g) || []).length;
    return Math.min(completedWords, Math.max(0, getTargetWordRanges().length - 1));
}

function flashWordError(index) {
    const word = document.querySelector(
        `#text-display .word[data-word-index="${index}"]`);
    if (!word) return;
    word.classList.remove("word-input-error");
    void word.offsetWidth;
    word.classList.add("word-input-error");
    setTimeout(() => word.classList.remove("word-input-error"), 180);
}

function renderText() {
    document.getElementById("text-display").innerHTML = getTargetWordRanges()
        .map((range, index) =>
            `<span class="word ${index === 0 ? "active" : ""}" data-word-index="${index}">` +
            [...range.word].map(char =>
                `<span class="char">${escapeHtml(char)}</span>`).join("") +
            `</span>`).join(" ");
}

function renderWord(expectedWord, typedWord) {
    const result = [];
    for (let index = 0; index < expectedWord.length; index++) {
        const typed = typedWord[index];
        result.push({
            ch: typed || expectedWord[index],
            expected: expectedWord[index],
            state: typed
                ? typed === expectedWord[index] ? "correct" : "wrong"
                : "pending"
        });
    }
    for (let index = expectedWord.length;
         index < Math.min(typedWord.length, expectedWord.length + 8);
         index++) {
        result.push({ ch: typedWord[index], expected: "", state: "extra" });
    }
    return result;
}

function renderRaceHistory() {
    const bar = document.getElementById("result-leader-bar");
    const status = document.getElementById("result-history-status");
    if (!raceAnalysis || !raceTimeline || !raceTimeline.players.length) return;
    const timelinePlayers = Object.fromEntries(raceTimeline.players.map(player =>
        [player.id, player]));
    const names = Object.fromEntries(raceTimeline.players.map(player =>
        [player.id, player.name]));
    const total = Math.max(1, raceAnalysis.totalMs);
    bar.innerHTML = raceAnalysis.leaderSegments.map(segment => `
        <span style="width:${(segment.toMs - segment.fromMs) * 100 / total}%"
              title="${escapeHtml(names[segment.playerId] || segment.playerId)}">${escapeHtml(names[segment.playerId] || segment.playerId)}</span>`).join("");
    status.textContent = "Lenktynių istorija paruošta";
    document.getElementById("result-overtakes-list").innerHTML =
        raceAnalysis.overtakes.length
            ? raceAnalysis.overtakes.map(item =>
                `<p>${(item.atMs / 1000).toFixed(1)} s
                 ${escapeHtml(names[item.passerId] || item.passerId)}
                 ${botBadge(timelinePlayers[item.passerId])}
                 aplenkė ${escapeHtml(names[item.passedId] || item.passedId)}
                 ${botBadge(timelinePlayers[item.passedId])}</p>`).join("")
            : "<p>Aplenkimų nebuvo.</p>";
    const leader = raceAnalysis.leaderTimeMs[PLAYER_KEY] || 0;
    document.getElementById("result-leader-summary").textContent =
        `Tu pirmavai ${(leader * 100 / total).toFixed(1)}% laiko · ` +
        `${raceAnalysis.leaderChanges} lyderio pasikeitimai`;
}

function renderReplay() {
    document.getElementById("replay-race").hidden = false;
    const track = document.getElementById("replay-track");
    track.innerHTML = raceTimeline.players.map((player, index) => `
        <div class="replay-lane" data-replay-player="${escapeHtml(player.id)}">
            <span class="replay-player-name">
                ${escapeHtml(player.name)} ${botBadge(player)}
            </span>
            <div class="replay-lane-track" data-replay-track="${escapeHtml(player.id)}">
                <div class="replay-monkey" data-replay-monkey="${escapeHtml(player.id)}">
                ${monkeyTemplate(getBotColorIndex(player, index))}
                </div>
            </div>
        </div>`).join("");
    const range = document.getElementById("replay-range");
    range.max = Math.max(0, (raceTimeline.players[0]?.series.length || 1) - 1);
    range.value = 0;
    replayIndex = 0;
    updateReplayFrame();
}

function updateReplayFrame() {
    if (!raceTimeline || !raceTimeline.players.length) return;
    raceTimeline.players.forEach(player => {
        const series = player.series;
        const value = series[Math.min(replayIndex, series.length - 1)] || 0;
        const percent = raceTextLength ? Math.min(1, value / raceTextLength) : 0;
        const monkey = document.querySelector(
            `[data-replay-monkey="${CSS.escape(player.id)}"]`);
        const track = document.querySelector(
            `[data-replay-track="${CSS.escape(player.id)}"]`);
        if (monkey && track) {
            const travel = Math.max(0, track.clientWidth - monkey.offsetWidth);
            monkey.style.transform = `translateX(${percent * travel}px)`;
        }
    });
    const totalTicks = raceTimeline.players[0]?.series.length || 1;
    const currentSeconds = replayIndex * (raceTimeline.tickMs || 250) / 1000;
    const totalSeconds = Math.max(0, (totalTicks - 1) *
        (raceTimeline.tickMs || 250) / 1000);
    document.getElementById("replay-range").value = replayIndex;
    document.getElementById("replay-time").textContent =
        `${currentSeconds.toFixed(1).replace(".", ",")} s / ` +
        `${totalSeconds.toFixed(1).replace(".", ",")} s`;
}

function renderWpmChart() {
    const player = raceTimeline.players.find(item => item.id === PLAYER_KEY);
    if (!player) return;
    const lastValue = player.series[player.series.length - 1] || 0;
    // grafikas baigiasi mano finiše, kitaip laukimas kitų žaidėjų numuštų greitį ir vidurkį iki 0
    const totalTicks = Math.max(1, player.series.indexOf(lastValue) + 1);
    const fullSeries = player.series.length ? player.series.slice(0, totalTicks) : [0];
    const points = fullSeries.map((value, index) => {
        const from = Math.max(0, index - 12);
        const elapsed = (index - from) * 250 / 60000;
        return elapsed ? (value - fullSeries[from]) / 5 / elapsed : 0;
    });
    const peak = Math.max(1, ...points);
    const step = peak <= 25 ? 5 : peak <= 100 ? 25 : 50;
    const chartMax = Math.max(step, Math.ceil(peak / step) * step);
    const chartWidth = 640;
    const chartHeight = 180;
    const left = 42;
    const right = 12;
    const top = 12;
    const bottom = 30;
    const plotWidth = chartWidth - left - right;
    const plotHeight = chartHeight - top - bottom;
    const x = index => left + index * plotWidth /
        Math.max(1, points.length - 1);
    const y = value => top + plotHeight - value * plotHeight / chartMax;
    const linePoints = points.map((value, index) =>
        `${x(index)},${y(value)}`).join(" ");
    const areaPoints = `${left},${top + plotHeight} ${linePoints} ` +
        `${x(Math.max(0, points.length - 1))},${top + plotHeight}`;
    const grid = [];
    for (let value = 0; value <= chartMax; value += step) {
        grid.push(`<line class="chart-grid-line" x1="${left}" x2="${chartWidth - right}"
            y1="${y(value)}" y2="${y(value)}"/>
            <text class="chart-axis-label" x="${left - 7}" y="${y(value) + 4}"
            text-anchor="end">${value}</text>`);
    }
    const totalSeconds = Math.max(0.001,
        (totalTicks - 1) * (raceTimeline.tickMs || 250) / 1000);
    const average = lastValue / 5 / (totalSeconds / 60);
    const highIndex = points.indexOf(peak);
    const seconds = index => (index * (raceTimeline.tickMs || 250) / 1000).toFixed(1);
    document.getElementById("result-wpm-chart").innerHTML = `
        ${grid.join("")}
        <line class="chart-axis" x1="${left}" x2="${left}"
              y1="${top}" y2="${top + plotHeight}"/>
        <line class="chart-axis" x1="${left}" x2="${chartWidth - right}"
              y1="${top + plotHeight}" y2="${top + plotHeight}"/>
        <text class="chart-axis-title" x="12" y="${top + plotHeight / 2}"
              transform="rotate(-90 12 ${top + plotHeight / 2})">WPM</text>
        <text class="chart-axis-title" x="${chartWidth - right}" y="${chartHeight - 4}"
              text-anchor="end">s</text>
        <polygon class="chart-area" points="${areaPoints}"/>
        <line class="chart-average" x1="${left}" x2="${chartWidth - right}"
              y1="${y(average)}" y2="${y(average)}"/>
        <text class="chart-average-label" x="${chartWidth - right - 3}"
              y="${y(average) - 5}" text-anchor="end">vid. ${Math.round(average)}</text>
        <polyline class="chart-line" points="${linePoints}"/>
        <circle class="chart-high-point" cx="${x(highIndex)}" cy="${y(peak)}" r="4"/>
        <text class="chart-high-label" x="${x(highIndex) + 6}" y="${y(peak) - 7}">${Math.round(peak)}</text>`;
    document.getElementById("result-wpm-average").textContent =
        `${Math.round(average)} WPM`;
    document.getElementById("result-wpm-high").textContent =
        `${Math.round(peak)} WPM`;
}

function renderWordErrors() {
    const words = getTargetWordRanges().map(range => range.word);
    const markup = words.map((word, index) => {
        const state = wordErrorStates[index] || 0;
        return `<span class="${state === 1 ? "word-fixed" : state === 2 ? "word-wrong" : ""}">
            ${escapeHtml(word)}</span>`;
    }).join(" ");
    document.getElementById("result-error-words").innerHTML = markup;
    document.getElementById("result-error-list").innerHTML = words
        .filter((word, index) => wordErrorStates[index] > 0)
        .map(word => `<li>${escapeHtml(word)}</li>`).join("") || "<li>Nėra klaidingų žodžių.</li>";
}

document.getElementById("replay-play").addEventListener("click", () => {
    if (replayTimer || !raceTimeline) return;
    setReplayPlayingState(true);
    replayTimer = setInterval(() => {
        const length = raceTimeline.players[0]?.series.length || 0;
        if (replayIndex >= length - 1) {
            clearInterval(replayTimer);
            replayTimer = null;
            setReplayPlayingState(false);
            return;
        }
        replayIndex++;
        updateReplayFrame();
    }, Math.max(16, 250 / replaySpeed));
});
document.getElementById("replay-pause").addEventListener("click", () => {
    clearInterval(replayTimer);
    replayTimer = null;
    setReplayPlayingState(false);
});
document.getElementById("replay-reset").addEventListener("click", () => {
    clearInterval(replayTimer);
    replayTimer = null;
    setReplayPlayingState(false);
    replayIndex = 0;
    updateReplayFrame();
});
document.querySelectorAll("[data-replay-speed]").forEach(button => {
    button.addEventListener("click", () => {
        replaySpeed = Number(button.dataset.replaySpeed);
        document.querySelectorAll("[data-replay-speed]").forEach(speedButton =>
            speedButton.setAttribute("aria-pressed", speedButton === button ? "true" : "false"));
        if (replayTimer) {
            clearInterval(replayTimer);
            replayTimer = null;
            document.getElementById("replay-play").click();
        }
    });
});
document.getElementById("replay-range").addEventListener("input", event => {
    clearInterval(replayTimer);
    replayTimer = null;
    setReplayPlayingState(false);
    replayIndex = Number(event.target.value);
    updateReplayFrame();
});
window.addEventListener("resize", () => {
    if (raceTimeline) updateReplayFrame();
});

function setReplayPlayingState(isPlaying) {
    const button = document.getElementById("replay-play");
    button.setAttribute("aria-pressed", String(isPlaying));
    button.setAttribute("aria-label",
        isPlaying ? "Paleisti lenktynių replay iš naujo" :
            "Paleisti lenktynių replay");
    button.innerHTML = isPlaying
        ? `<svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true">
             <path d="M7 5h4v14H7zm6 0h4v14h-4z"/></svg><span>Vyksta</span>`
        : `<svg class="control-icon" viewBox="0 0 24 24" aria-hidden="true">
             <path d="M8 5v14l11-7z"/></svg><span>Paleisti</span>`;
}

function renderPlayers() {
    document.getElementById("players-track").innerHTML =
        Object.values(players).map((player, index) => `
        <div class="player-track ${player.playerKey === PLAYER_KEY ? "is-me" : ""}" id="track-${cssId(player.playerKey)}" style="--progress: 0%"
             tabindex="0" aria-label="${escapeHtml(player.username)}: žaidėjo kortelė">
            <span class="player-monkey ${player.isBot ? "player-monkey-bot" : "player-monkey-human"}">
                ${monkeyTemplate(player.playerKey === PLAYER_KEY ? 2 : player.isBot ? getBotColorIndex(player, index) : index, playerLevel(player))}
            </span>
            <span class="player-name">${escapeHtml(player.username)}
                ${player.playerKey === PLAYER_KEY ? `<span class="tag tag-me">Tu</span>` : botBadge(player) || `<span class="tag">Žaidėjas</span>`}</span>
            <span class="player-wpm" id="wpm-${cssId(player.playerKey)}">${player.wpm || 0} WPM</span>
            <div class="player-card-pop" role="tooltip">${playerCardHtml(player)}</div>
        </div>`).join("");
}

// Mobiliajame kortelė atsidaro paspaudus (hover neveikia)
document.getElementById("players-track").addEventListener("click", event => {
    const track = event.target.closest(".player-track");
    document.querySelectorAll(".player-track.card-open").forEach(item => {
        if (item !== track) item.classList.remove("card-open");
    });
    if (track) track.classList.toggle("card-open");
});

function cssId(value) {
    return value.replace(/[^a-zA-Z0-9_-]/g, "_");
}

function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, char =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" }[char]));
}

async function leaveRace() {
    const leaveButton = document.getElementById("leave-button");
    if (leaveButton) {
        leaveButton.disabled = true;
        leaveButton.textContent = "Išeinama...";
    }
    if (finished) {
        window.location.href = "/";
        return;
    }
    try {
        if (connection.state === signalR.HubConnectionState.Connected)
            await connection.invoke("LeaveRace", RACE_ID, PLAYER_KEY);
    } catch (error) {
        console.warn("Nepavyko pranešti serveriui apie išėjimą.", error);
    } finally {
        window.location.href = "/";
    }
}

connection.start()
    .then(() => connection.invoke("JoinRace", RACE_ID, PLAYER_KEY, USERNAME, TAB_ID))
    .catch(retryMatchmaking);
</script>
