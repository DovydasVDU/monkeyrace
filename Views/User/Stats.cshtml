@model UserProfileViewModel
@using Microsoft.AspNetCore.Http
@{
    var username = ViewContext.HttpContext.Session.GetString("Username") ?? Model.Username;
}
@{ ViewData["Title"] = "Stats - Monkeyrace"; }

<!DOCTYPE html>
<html>
<head>
    <title>MonkeyRacer - Profile</title>
    <link rel="stylesheet" href="/css/login.css">
    <style>


        /* PROFILE */
        .profile-container {
            max-width: 1100px;
            margin: 2.5rem auto;
            padding: 0 2rem 3rem;
        }

        .hero {
            background: var(--surface);
            border: 1px solid #333;
            border-radius: 12px;
            padding: 2.5rem;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            box-shadow: 0 8px 25px rgba(0,0,0,0.35);
        }

            .hero h1 {
                color: var(--accent);
                font-size: 1.6rem;
                letter-spacing: .08em;
            }

        .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.2rem;
        }

        .stat-card {
            background: #111827;
            border: 1px solid #2a2a3f;
            border-radius: 10px;
            padding: 1.2rem;
        }

        .stat-title {
            color: var(--muted);
            font-size: .8rem;
            letter-spacing: .12em;
        }

        .stat-value {
            font-size: 1.6rem;
            margin-top: .4rem;
            color: var(--text);
        }

        .section {
            margin-top: 2rem;
            display: grid;
            grid-template-columns: 1.2fr 1.8fr;
            gap: 1.5rem;
        }

        .panel {
            background: var(--surface);
            border: 1px solid #333;
            border-radius: 12px;
            padding: 1.6rem;
        }

            .panel h2 {
                color: var(--accent);
                font-size: 1.1rem;
                margin-bottom: 1rem;
                letter-spacing: .1em;
            }

        .intro {
            color: var(--text);
            line-height: 1.6;
        }

        .past-races {
            width: 100%;
            border-collapse: collapse;
        }

            .past-races th, .past-races td {
                text-align: left;
                padding: .7rem .5rem;
                border-bottom: 1px solid #2a2a3f;
                color: var(--text);
                font-size: .9rem;
            }

            .past-races th {
                color: var(--muted);
                font-weight: normal;
                letter-spacing: .08em;
                font-size: .75rem;
            }
        /**/
        @@media (max-width: 900px) {
            .stats-row {
                grid-template-columns: 1fr;
            }

            .section {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <div class="main-content">
        <div class="profile-container">
            <div class="hero">
                <h1>Profile overview</h1>

                <div class="stats-row">
                    <div class="stat-card">
                        <div class="stat-title">VARTOTOJAS</div>
                        <div class="stat-value">@Model.Username</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-title">VIDUTINIS WPM</div>
                        <div class="stat-value">@Model.AverageWpm</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-title">VIDUTINIS TIKSLUMAS</div>
                        <div class="stat-value">@Model.AverageAccuracy.ToString("0.0")%</div>
                    </div>
                </div>
            </div>

            <div class="section">
                <div class="panel">
                    <h2>APIE VARTOTOJĄ</h2>
                    <p class="intro">
                        <strong>@Model.Username</strong> rimtai žiūri į spausdinimo greitį.
                        Su vidutiniu greičiu <strong>@Model.AverageWpm WPM</strong> ir
                        tikslumu apie <strong>@Model.AverageAccuracy.ToString("0.0")%</strong>,
                        pažanga kalba pati už save. Išlaikykite dėmesį, išlaikykite ritmą.
                    </p>
                </div>

                <div class="panel">
                    <h2>Spausdinimai</h2>
                    <table class="past-races">
                        <thead>
                            <tr>
                                <th>DATA</th>
                                <th>ŽODŽIAI PER MINUTĘ</th>
                                <th>TIKSLUMAS</th>
                                <th>KLAIDOS</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var race in Model.PastRaces)
                            {
                                <tr>
                                    <td>@race.CompletedAt.ToString("yyyy-MM-dd")</td>
                                    <td>@race.Wpm</td>
                                    <td>@race.Accuracy.ToString("0.0")%</td>
                                    <td>@race.ErrorCount</td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        
    </div>


</body>
</html>