@model UserProfileViewModel
@inject RaceService RaceService

@{
    ViewData["Title"] = "Profilis - MonkeyRace";
    // lygis, XP ir bananai – tas pats šaltinis kaip navbar profilio kortelėje
    var userId = PlayerIdentity.GetUserId(Context);
    var card = userId == null ? null : await RaceService.GetPlayerCardAsync(userId.Value);
    var xpPercent = card == null ? 0 : (int)Math.Round(card.LevelProgress * 100);
    // shortcut: statinės prekės be backend'o, kol parduotuvė neveikia – pridėti modelį, kai bus pirkimai
    var hats = new[] { ("Žalia kepurė", "#2E8B4F", 0), ("Bananų kepurė", "#FFC93C", 150), ("Raudona kepurė", "#C93A3A", 300) };
    var furs = new[] { ("Ruda", "#8B5E3C", 0), ("Auksinė", "#B98300", 400), ("Tamsi", "#5E3B22", 600) };
    var tracks = new[] { ("Klasikinis", "track-classic", 0), ("Lapų", "track-leaf", 250), ("Bananų", "track-banana", 500) };
    var mistakes = Model.Mistakes;
    string KeyLabel(string key) => key == " " ? "tarpas" : key;
    bool IsLithuanian(string key) => "ąčęėįšųūž".Contains(key.ToLowerInvariant());
}

<div class="profile-page">
    <div class="profile-grid">
        <section class="card profile-hero" aria-labelledby="profile-title">
            <div class="profile-hero-head">
                <span class="profile-hero-monkey" aria-hidden="true">
                    @await Html.PartialAsync("_Monkey", new MonkeyViewModel { HatColor = "#2E8B4F", Level = card?.Level })
                </span>
                <div>
                    <p class="eyebrow">Žaidėjo profilis</p>
                    <h1 id="profile-title">@Model.Username</h1>
                </div>
            </div>

            @if (card != null)
            {
                <div class="profile-xp">
                    <div class="profile-xp-label">
                        <strong>Lygis @card.Level</strong>
                        <span>@(card.XpToNext == null ? "Maksimalus lygis" : $"Iki {card.Level + 1} lygio: {card.XpToNext} XP")</span>
                    </div>
                    <span class="xp-track" role="progressbar" aria-label="XP iki kito lygio"
                          aria-valuemin="0" aria-valuemax="100" aria-valuenow="@xpPercent">
                        <span style="width:@(xpPercent)%"></span>
                    </span>
                </div>
            }

            <div class="profile-stats">
                <div class="result-metric"><span>Vidutinis WPM</span><strong>@Model.AverageWpm</strong></div>
                <div class="result-metric"><span>Tikslumas</span><strong>@Model.AverageAccuracy.ToString("0.0")%</strong></div>
                <div class="result-metric"><span>Geriausias WPM</span><strong>@(card?.BestWpm ?? 0)</strong></div>
                <div class="result-metric result-metric-banana">
                    <span>Bananai</span>
                    <strong><svg class="icon" aria-hidden="true"><use href="#icon-banana"></use></svg> @(card?.Bananas ?? 0)</strong>
                </div>
            </div>
        </section>

        <section class="card shop" id="shop" aria-labelledby="shop-title">
            <div class="shop-head">
                <h2 id="shop-title"><svg class="ui-icon" aria-hidden="true"><use href="#icon-shop"></use></svg>Parduotuvė</h2>
                <span class="pill">Netrukus</span>
            </div>

            <div class="tm-group" role="group" aria-label="Prekių kategorija">
                <button class="tm" type="button" aria-pressed="true" data-shop-tab="hats">Kepurės</button>
                <button class="tm" type="button" aria-pressed="false" data-shop-tab="furs">Spalvos</button>
                <button class="tm" type="button" aria-pressed="false" data-shop-tab="tracks">Takeliai</button>
            </div>

            <div class="shop-grid" data-shop-panel="hats">
                @foreach (var (name, color, price) in hats)
                {
                    <article class="shop-item">
                        <span class="shop-preview" aria-hidden="true">@await Html.PartialAsync("_Monkey", new MonkeyViewModel { HatColor = color })</span>
                        <h3>@name</h3>
                        <p class="shop-price"><svg class="icon" aria-hidden="true"><use href="#icon-banana"></use></svg> @price</p>
                        <button class="btn btn-s" type="button" disabled>Netrukus</button>
                    </article>
                }
            </div>
            <div class="shop-grid" data-shop-panel="furs" hidden>
                @foreach (var (name, color, price) in furs)
                {
                    <article class="shop-item">
                        <span class="shop-preview" aria-hidden="true">@await Html.PartialAsync("_Monkey", new MonkeyViewModel { BodyColor = color, HatColor = "none" })</span>
                        <h3>@name</h3>
                        <p class="shop-price"><svg class="icon" aria-hidden="true"><use href="#icon-banana"></use></svg> @price</p>
                        <button class="btn btn-s" type="button" disabled>Netrukus</button>
                    </article>
                }
            </div>
            <div class="shop-grid" data-shop-panel="tracks" hidden>
                @foreach (var (name, cssClass, price) in tracks)
                {
                    <article class="shop-item">
                        <span class="shop-preview shop-track @cssClass" aria-hidden="true"><span></span></span>
                        <h3>@name</h3>
                        <p class="shop-price"><svg class="icon" aria-hidden="true"><use href="#icon-banana"></use></svg> @price</p>
                        <button class="btn btn-s" type="button" disabled>Netrukus</button>
                    </article>
                }
            </div>

            <p class="shop-note">
                <svg class="icon" aria-hidden="true"><use href="#icon-lock"></use></svg>
                Parduotuvė dar ruošiama. Rink bananus lenktynėse – jie išliks.
            </p>
        </section>
    </div>

    <section class="card mistakes" aria-labelledby="mistakes-title">
        <div class="shop-head">
            <h2 id="mistakes-title"><svg class="ui-icon" aria-hidden="true"><use href="#icon-target"></use></svg>Klaidų analizė</h2>
            @if (mistakes.Attempts > 0)
            {
                <span class="pill">Raidžių tikslumas @mistakes.Accuracy.ToString("0.0")%</span>
            }
        </div>

        @if (mistakes.Attempts == 0)
        {
            <p class="lb-empty">Sužaisk kelias lenktynes – čia pamatysi silpniausias raides ir žodžius, kuriuose dažniausiai klysti.</p>
        }
        else
        {
            <div class="mistakes-grid">
                <div class="mistakes-col">
                    <h3>Silpniausios raidės</h3>
                    @if (mistakes.WeakLetters.Count == 0)
                    {
                        <p class="mistakes-note">Dar per mažai duomenų: raidė rodoma po @RaceService.MinLetterAttempts bandymų.</p>
                    }
                    <ul class="mistakes-list">
                        @foreach (var letter in mistakes.WeakLetters)
                        {
                            var percent = letter.MissPercent;
                            <li class="mistake-letter">
                                <span class="key @(IsLithuanian(letter.Letter) ? "key-lt" : "")">@KeyLabel(letter.Letter)</span>
                                <span class="mistake-bar" role="img" aria-label="@KeyLabel(letter.Letter): @percent.ToString("0")% klaidų">
                                    <span style="width:@Math.Max(4, Math.Min(100, percent)).ToString("0", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                </span>
                                <span class="mistake-num"><strong>@percent.ToString("0")%</strong> @letter.Misses/@letter.Attempts</span>
                            </li>
                        }
                    </ul>
                </div>

                <div class="mistakes-col">
                    <h3>Dažniausiai sumaišai</h3>
                    @if (mistakes.Confusions.Count == 0)
                    {
                        <p class="mistakes-note">Klaidų nėra.</p>
                    }
                    <ul class="mistakes-list">
                        @foreach (var confusion in mistakes.Confusions)
                        {
                            <li class="mistake-pair">
                                <span class="key @(IsLithuanian(confusion.Expected) ? "key-lt" : "")" aria-hidden="true" title="Reikėjo">@KeyLabel(confusion.Expected)</span>
                                <svg class="icon mistake-arrow" aria-hidden="true"><use href="#icon-arrow-left"></use></svg>
                                <span class="key key-typed" aria-hidden="true" title="Parašei">@KeyLabel(confusion.Typed)</span>
                                <span class="visually-hidden">Vietoj @KeyLabel(confusion.Expected) parašei @KeyLabel(confusion.Typed)</span>
                                <span class="mistake-num"><strong>@confusion.Count</strong> k.</span>
                            </li>
                        }
                    </ul>
                </div>

                <div class="mistakes-col">
                    <h3>Probleminiai žodžiai</h3>
                    @if (mistakes.Words.Count == 0)
                    {
                        <p class="mistakes-note">Neišmoktų žodžių nėra.</p>
                    }
                    <ul class="mistakes-list">
                        @foreach (var word in mistakes.Words)
                        {
                            <li class="mistake-word">
                                <span class="mistake-word-text">@word.Word</span>
                                <span class="mistake-num"><strong>@word.Misses</strong> @(word.Misses == 1 ? "klaida" : "klaidos")</span>
                            </li>
                        }
                    </ul>
                    @if (mistakes.MasteredWords > 0)
                    {
                        <p class="mistakes-note">Išmokta žodžių: @mistakes.MasteredWords (@RaceService.MasteredStreak kartus iš eilės be klaidų).</p>
                    }
                </div>
            </div>

            @if (mistakes.Words.Count > 0 || mistakes.WeakLetters.Count > 0)
            {
                <div class="mistakes-foot">
                    <a class="btn btn-p" href="/race/train">
                        <svg class="icon" aria-hidden="true"><use href="#icon-keyboard"></use></svg>Treniruotis
                    </a>
                    <span class="mistakes-note">Tekstas iš tavo neišmoktų žodžių ir silpniausių raidžių. XP neskiriama.</span>
                </div>
            }
        }
    </section>

    <section class="card profile-history" aria-labelledby="history-title">
        <h2 id="history-title"><svg class="ui-icon" aria-hidden="true"><use href="#icon-chart"></use></svg>Paskutinės lenktynės</h2>

        @if (Model.PastRaces.Count == 0)
        {
            <p class="lb-empty">Dar nesudalyvavai nė vienose lenktynėse. <a href="/race/quick">Žaisk dabar!</a></p>
        }
        else
        {
            <div class="history-table" role="table" aria-label="Paskutinės lenktynės">
                <div class="lb-row lb-header" role="row">
                    <span role="columnheader">Data</span>
                    <span role="columnheader">WPM</span>
                    <span role="columnheader">Tikslumas</span>
                    <span role="columnheader">Klaidos</span>
                </div>
                @foreach (var race in Model.PastRaces)
                {
                    <div class="lb-row" role="row">
                        <span class="lb-date" role="cell">@race.CompletedAt.ToString("yyyy-MM-dd")</span>
                        <span class="lb-num" role="cell"><strong>@race.Wpm</strong></span>
                        <span role="cell">@race.Accuracy.ToString("0.0")%</span>
                        <span role="cell">@race.ErrorCount</span>
                    </div>
                }
            </div>
        }
    </section>
</div>

<script>
    // Parduotuvės kategorijų perjungimas (tik rodymas, pirkimų dar nėra)
    document.querySelectorAll('[data-shop-tab]').forEach(tab => tab.addEventListener('click', () => {
        document.querySelectorAll('[data-shop-tab]').forEach(t => t.setAttribute('aria-pressed', String(t === tab)));
        document.querySelectorAll('[data-shop-panel]').forEach(p => p.hidden = p.dataset.shopPanel !== tab.dataset.shopTab);
    }));
</script>
