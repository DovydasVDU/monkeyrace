@using Microsoft.AspNetCore.Http
@{
    var username = Context.Session.GetString("Username");
}

<!DOCTYPE html>
<html lang="lt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MonkeyRacer</title>

    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header class="navbar">

        <div class="logo">
            <a href="/" style="        text-decoration: none;
        color: #e2b714;">MonkeyRacer</a>
        </div>

        <div class="nav-right">

            @if (username != null)
            {
<div class="user-menu"
     onclick="toggleMenu()"
     style="margin-right: 15px;">

    <div class="user-icon">
        @username.Substring(0, 1).ToUpper()
    </div>

    <div class="username">
        @username
    </div>

    <div class="dropdown" id="userDropdown">
        <div id="quick-stats" class="quick-stats"></div>
    </div>

</div>

                <button class="nav-btn icon-btn"
                        onclick="window.location='/User/Stats'"
                        title="Statistika">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="20"
                         height="20"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <line x1="18" y1="20" x2="18" y2="10"></line>
                        <line x1="12" y1="20" x2="12" y2="4"></line>
                        <line x1="6" y1="20" x2="6" y2="14"></line>

                    </svg>

                </button>

                                <button class="nav-btn icon-btn"
                                        onclick="window.location='/Auth/Logout'"
                                        title="Atsijungti"
                                        style="margin-left: 10px;">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="20"
                                         height="20"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2">

                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                        <polyline points="16 17 21 12 16 7"></polyline>
                                        <line x1="21" y1="12" x2="9" y2="12"></line>

                                    </svg>

                                </button> }
                            else
                            {
                <button class="nav-btn" onclick="openLogin()">
                    Login
                </button>}

        </div>

    </header>
    <!-- LOGIN MODAL -->

    <div class="modal" id="loginModal">

        <div class="modal-box" style="position: relative;">

            <span onclick="closeLogin()" style="position: absolute; top: 1rem; right: 1rem; cursor: pointer; color: var(--muted); font-size: 1.2rem;">&times;</span>

            <h3>Prisijungimas</h3>

            <input id="login-user" placeholder="slapyvardis">
            <input id="login-pass" type="password" placeholder="slaptažodis">

            <button class="btn" onclick="login()">Prisijungti</button>
            <button class="btn" onclick="register()">Registruotis</button>

        </div>

    </div>


    <script src="~/js/site.js"></script>

</body>
</html>