@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@inject RaceService RaceService
@{ var username = User.FindFirstValue(ClaimTypes.Name); var isAuthenticated = User.Identity?.IsAuthenticated == true; }
@{
    // XP, lygis ir bananai iš DB, todėl atnaujinami kiekvieną kartą perkrovus puslapį
    var userId = PlayerIdentity.GetUserId(Context);
    var card = userId == null ? null : await RaceService.GetPlayerCardAsync(userId.Value);
    var xpPercent = card == null ? 0 : (int)Math.Round(card.LevelProgress * 100);
    var path = Context.Request.Path.Value ?? "/";
    var playActive = path.StartsWith("/race", StringComparison.OrdinalIgnoreCase);
    var profileActive = path.StartsWith("/User/Stats", StringComparison.OrdinalIgnoreCase);
}

<header class="navbar monkey-navbar">

    <div class="logo monkey-logo">
        <a href="/" aria-label="MonkeyRace pradžia">
            <span class="logo-mark">@await Html.PartialAsync("_Monkey", new MonkeyViewModel { HatColor = "#2E8B4F" })</span>
            <span>Monkey <span class="logo-race">Race</span></span>
        </a>
    </div>

    <nav class="desktop-nav" aria-label="Pagrindinė navigacija">
        <a href="/race/quick" class="@(playActive ? "is-active" : "")" aria-current="@(playActive ? "page" : null)">Žaisti</a>
        <a href="/#top10-body">Lyderiai</a>
        <a href="@(isAuthenticated ? "/User/Stats#shop" : "#")"
           class="@(isAuthenticated ? "" : "nav-disabled")"
           aria-disabled="@(isAuthenticated ? null : "true")">Parduotuvė</a>
    </nav>

    <div class="nav-right">
        @if (username != null)
        {
            <div class="user-menu" onmouseenter="openMenu()" onmouseleave="closeMenu()">
                <a class="profile-card" href="/User/Stats" aria-label="Profilis: @username, lygis @(card?.Level)">
                    <span class="profile-avatar">
                        @await Html.PartialAsync("_Monkey", new MonkeyViewModel { HatColor = card?.HatColor ?? "#2E8B4F", BodyColor = card?.FurColor ?? "#8D5A2B" })
                        @if (card != null)
                        {
                            <span class="level-badge">@card.Level</span>
                        }
                    </span>
                    <span class="profile-main">
                        <span class="profile-name">@username</span>
                        @if (card != null)
                        {
                            <span class="xp-track" role="progressbar" aria-label="XP iki kito lygio"
                                  aria-valuemin="0" aria-valuemax="100" aria-valuenow="@xpPercent">
                                <span style="width:@(xpPercent)%"></span>
                            </span>
                            <span class="profile-next">@(card.XpToNext == null ? "Maksimalus lygis" : $"Iki {card.Level + 1} lygio: {card.XpToNext} XP")</span>
                        }
                    </span>
                    @if (card != null)
                    {
                        <span class="profile-stat"><strong>@card.BestWpm</strong><span>geriausias WPM</span></span>
                        <span class="profile-stat"><strong><svg class="icon" aria-hidden="true"><use href="#icon-banana"></use></svg> @card.Bananas</strong><span>bananai</span></span>
                        <span class="profile-compact">
                            <span>Lvl @card.Level</span>
                            <span><svg class="icon" aria-hidden="true"><use href="#icon-banana"></use></svg> @card.Bananas</span>
                        </span>
                    }
                </a>

                <div class="dropdown" id="userDropdown">
                    <div id="quick-stats" class="quick-stats"></div>
                </div>
            </div>

            <button class="icon-btn" type="button" onclick="window.location='/Auth/Logout'"
                    title="Atsijungti" aria-label="Atsijungti">
                <svg class="ui-icon" aria-hidden="true"><use href="#icon-logout"></use></svg>
            </button>
        }
        else
        {
            <button class="btn btn-p" type="button" onclick="openLogin()">Prisijungti</button>
        }
    </div>

</header>

<nav class="mobile-tabs" aria-label="Mobilioji navigacija">
    <a href="/race/quick" class="@(playActive ? "is-active" : "")">
        <svg class="ui-icon" aria-hidden="true"><use href="#icon-flag"></use></svg>Žaisti
    </a>
    <a href="/#top10-body">
        <svg class="ui-icon" aria-hidden="true"><use href="#icon-trophy"></use></svg>Lyderiai
    </a>
    <a href="@(isAuthenticated ? "/User/Stats" : "#")"
       class="@(isAuthenticated ? "" : "nav-disabled") @(profileActive ? "is-active" : "")">
        <svg class="ui-icon" aria-hidden="true"><use href="#icon-user"></use></svg>Profilis
    </a>
    <a href="@(isAuthenticated ? "/User/Stats#shop" : "#")" class="@(isAuthenticated ? "" : "nav-disabled")">
        <svg class="ui-icon" aria-hidden="true"><use href="#icon-shop"></use></svg>Parduotuvė
    </a>
</nav>

<!-- LOGIN MODAL: .modal turi likti pilno ekrano fonu (login.js uždaro paspaudus šalia) -->
<div class="modal" id="loginModal">
    <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="login-title">
        <button class="modal-close" type="button" onclick="closeLogin()" aria-label="Uždaryti">
            <svg class="ui-icon" aria-hidden="true"><use href="#icon-close"></use></svg>
        </button>

        <h3 id="login-title">Prisijungimas</h3>

        <label>Slapyvardis
            <input id="login-user" autocomplete="username">
        </label>
        <label>Slaptažodis
            <input id="login-pass" type="password" autocomplete="current-password">
        </label>

        <div class="modal-actions">
            <button class="btn btn-p" type="button" onclick="login()">Prisijungti</button>
            <button class="btn btn-s" type="button" onclick="register()">Registruotis</button>
        </div>
    </div>
</div>

<script>
    const username = @Json.Serialize(username);

    async function loadMyStats() {
        if (!username) return;
        try {
            const res = await fetch(`/api/stats/${encodeURIComponent(username)}`);
            const data = await res.json();
            document.getElementById('quick-stats').innerHTML =
                `<span>Greitis (PB): <b>${data.bestWpm} WPM</b></span>
                 <span>Tikslumas: <b>${data.averageAccuracy}%</b></span>
                 <span>Žaidimai: <b>${data.totalRaces}</b></span>`;
        } catch (err) {
            console.error("Failed to load user stats", err);
        }
    }
    loadMyStats();
</script>
