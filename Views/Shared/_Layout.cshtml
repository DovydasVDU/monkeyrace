@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="lt">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(ViewData["Title"] ?? "MonkeyRace")</title>

    @* favicon.svg – tas pats _Monkey; .ico ir .png – Safari ir senoms naršyklėms *@
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <link rel="icon" href="~/favicon.ico" sizes="32x32">
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png">

    @* šriftai iš wwwroot/fonts (@font-face – site.css), be Google Fonts *@
    <link rel="preload" href="~/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin>

    <script src="~/js/login.js" asp-append-version="true"></script>
    <script src="~/js/progress.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/race.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/progress.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/lessons.css" asp-append-version="true">
</head>

<body>
    @await Html.PartialAsync("_Icons")
    @await Html.PartialAsync("_Backdrop")

    @await Html.PartialAsync("_Navbar")
    <main>
        @RenderBody()
    </main>
    @await Html.PartialAsync("_Footer")

</body>

</html>
