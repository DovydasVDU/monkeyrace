@model ChallengePage

@{
    ViewData["Title"] = "Mėnesio iššūkis - MonkeyRace";
    var penalty = MonthlyChallenge.ErrorPenaltySeconds;
    var mine = Model.Mine;
}

<section class="home-section challenge-page" aria-labelledby="challenge-title">
    <p class="eyebrow">@Model.Month</p>
    <h1 id="challenge-title">Mėnesio iššūkis: ilgiausi žodžiai</h1>
    <p class="lessons-intro">Parašyk @Model.Words.Count labai ilgus lietuviškus žodžius iš eilės kuo greičiau ir be klaidų. Rašai įprastame rašymo ekrane, laikas pradeda bėgti nuo pirmo klavišo ir jį matuoja serveris,
        o kiekviena klaida prideda @penalty s. Skaičiuojamas geriausias mėnesio bandymas. Pirmą kartą dalyvavęs gauni @MonthlyChallenge.ParticipationXp XP ir @MonthlyChallenge.ParticipationBananas bananų.</p>

    <div class="card challenge-card">
        <h2>Šio mėnesio žodžiai</h2>
        <ol class="challenge-words">
            @foreach (var word in Model.Words)
            {
                <li>@word</li>
            }
        </ol>

        @if (Model.LoggedIn)
        {
            @if (mine != null)
            {
                <p class="shop-note">Tavo geriausias: <strong>@mine.BestScore.ToString("0.00") s</strong> (@mine.BestSeconds.ToString("0.00") s, klaidų: @mine.BestErrors), bandymų: @mine.Attempts.</p>
            }
            <a class="btn btn-p" href="/menesio-issukis/zaisti">
                <svg class="ui-icon" aria-hidden="true"><use href="#icon-play"></use></svg>@(mine == null ? "Pradėti" : "Bandyti dar kartą")
            </a>
        }
        else
        {
            <p>Norėdamas dalyvauti, prisijunk.</p>
            <button class="btn btn-p" type="button" onclick="openLogin()">
                <svg class="ui-icon" aria-hidden="true"><use href="#icon-user"></use></svg>Prisijungti
            </button>
        }
    </div>

    <div class="card challenge-card">
        <h2><svg class="ui-icon" aria-hidden="true"><use href="#icon-trophy"></use></svg>Šio mėnesio lyderiai</h2>
        @if (Model.Top.Count == 0)
        {
            <p class="shop-note">Rezultatų dar nėra. Būk pirmas!</p>
        }
        else
        {
            <ol class="challenge-board">
                @foreach (var row in Model.Top)
                {
                    <li>
                        <strong>@row.Username</strong>
                        <span>@row.Score.ToString("0.00") s <small>(@row.Seconds.ToString("0.00") s + @row.Errors klaidų)</small></span>
                    </li>
                }
            </ol>
        }
    </div>
</section>

